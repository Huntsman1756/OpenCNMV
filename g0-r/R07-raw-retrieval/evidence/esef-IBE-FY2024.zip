 currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/textregion:0e1caa3d5dd942ecb1ab7640d0010d6c_2052"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/textregion:0e1caa3d5dd942ecb1ab7640d0010d6c_2057"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/textregion:0e1caa3d5dd942ecb1ab7640d0010d6c_2057"></wk:observed-region-end><span class="C-Bodytext">, una vez consideradas las coberturas a través de los derivados contratados, expresada en millones de euros, es la siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 437.25pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 278.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 79.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 79.5pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-7785677d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="TableGrid-nivel-1-aa2f15ed" style="margin-bottom: 0; margin-top: 0;"><span class="C-TableGrid-nivel-1-1a73cc65 C-TableGrid-nivel-1">sin dato</span></p></td><td class="cellStyle-7785677d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="TableGrid-nivel-1-aa2f15ed" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_0-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-TableGrid-nivel-1-c6f70f40 C-TableGrid-nivel-1">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_0-1-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-7785677d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_0-2-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-9767c61a C-Table-Normal">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_0-2-1-1-826894"></wk:observed-region-end></p></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-3c422916" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_1-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Tipo de interés fijo" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">Tipo de interés fijo</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_1-0-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-3c422916" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_91/frag:0e1caa3d5dd942ecb1ab7640d0010d6c/table:922bb691be634d7b819c4ee9927cf4d9/tablerange:922bb691be634d7b819c4ee9927cf4d9_1-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="11244" scale="0" show-positive-sign="false" show-thousands-s