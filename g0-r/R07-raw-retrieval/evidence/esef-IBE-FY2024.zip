 suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_19/frag:84777900ce85446f987bce0fb2953610/textregion:84777900ce85446f987bce0fb2953610_439"></wk:observed-region-end><span class="C-Bodytext-c3e5e06f C-Bodytext"> se presenta, única y exclusivamente, a efectos comparativos.</span></p><p class="Bodytext-61808c9f" style="font-size: 9pt;"><span class="C-Bodytext-c3e5e06f C-Bodytext">Las Notas descritas en la Memoria forman parte integrante del Estado de ingresos y gastos reconocidos correspondiente al ejercicio anual terminado el 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_19/frag:84777900ce85446f987bce0fb2953610/textregion:84777900ce85446f987bce0fb2953610_672"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_19/frag:84777900ce85446f987bce0fb2953610/textregion:84777900ce85446f987bce0fb2