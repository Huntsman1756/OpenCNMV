63/frag:d6c1f3b741e44fb69439bb49d3d64aba/table:c54936e9af614ad8b957c71c26f7047e"></wk:table-end></div><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 27.78pt; height: 70.87pt; left: 77.95pt; position: absolute; width: 474.53pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 474.53pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 63.77pt; position: absolute; top: 18.51pt; width: 488.43pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 488.43pt;"><div style="margin-bottom: 8pt; margin-top: 0; padding-right: 18pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-top: 2pt; vertical-align: text-bottom; width: 459.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 242.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 32.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">62</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-end></div><p class="Bodytext-3af96eee" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext" style="font-size: 11pt; margin-top: 0;"><span class="C-Bodytext">Adicionalmente, IBERDROLA realiza operaciones de cobertura de tipo de interés de acuerdo con su política de gestión de riesgos. Estas operaciones tienen por objeto, bien mitigar el efecto que la variación en los tipos de interés podría suponer sobre los flujos de caja futuros de los créditos y préstamos referenciados a tipo de interés variable, o bien mitigar la variación en el valor razonable que se podría producir en los préstamos y créditos que devengan un tipo de interés fijo.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de&#xa0; </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_1411"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_1411"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_1416"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_1416"></wk:observed-region-end><span class="C-Bodytext">, no existen pasivos financieros objeto de cobertura de tipo de interés.</span></p><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163"></wk:section-end><wk:section-start hidden-section="false" name="16.	 Información sobre el periodo medio de pago a proveedores" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_166102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 11pt;"><span id="i216c1a8c9cf64793a45781b9b0c5adc3"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166/frag:115bd3c8348643119350a68b3a1f0e07/textregion:115bd3c8348643119350a68b3a1f0e07_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="16. Información sobre el periodo medio de pago a proveedores. Disposición adicional tercera. “Deber de información” de la Ley 15/2010, de 5 de julio" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">16. Información sobre el periodo medio de pago a proveedores. Disposición adicional tercera. “Deber de información” de la Ley 15/2010, de 5 de julio</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166/frag:115bd3c8348643119350a68b3a1f0e07/textregion:115bd3c8348643119350a68b3a1f0e07_5"></wk:observed-region-end><span class="charStyle-3e6cc6c4">&#xa0; </span></p><p class="Bodytext-76c8d55f" style="font-size: 11pt;"><span class="C-Bodytext">El desglose de la información requerida correspondiente a los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166/frag:115bd3c8348643119350a68b3a1f0e07/textregion:115bd3c8348643119350a68b3a1f0e07_83"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166/frag:115bd3c8348643119350a68b3a1f0e07/textregion:115bd3c8348643119350a68b3a1f0e07_83"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_166/frag:115bd3c8348643119350a68b3a1f0e07/textregion:115bd3c8348643119350a68b3a1f0e07_88"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbo