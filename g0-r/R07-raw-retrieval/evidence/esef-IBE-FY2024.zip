ocs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1526"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1526"></wk:observed-region-end><span class="C-Bodytext">, expresada en millones de euros,</span><span class="C-Bodytext"> es la siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:69d0b164ec11444cb9a1a909e42b3fd6"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 453pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 372.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 80.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-7785677d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="TableGrid-nivel-1-aa2f15ed" style="margin-bottom: 0; margin-top: 0;"><span class="C-TableGrid-n