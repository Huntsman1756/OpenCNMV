bserved-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_3420"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_3420"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_3425"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b4