="font-size: 11pt; margin-top: 0;"><span class="C-Bodytext">El vencimiento de la deuda a cobrar, expresado en millones de euros, se producirá como sigue:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:fbb09154c1704af39448bdb9c00ba151"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 439.5pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 308.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 131.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-d9963a49" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:fbb09154c1704af39448bdb9c00ba151/tablerange:fbb09154c1704af39448bdb9c00ba151_0-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Años" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-9767c61a C-Table-Normal">Años</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/f