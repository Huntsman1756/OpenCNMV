0; width: 25.5pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">95</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-1" style="font-size: 17pt; margin-top: 0;"><span id="i822bd9d912ef4c4392753aef706ab9db"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="25. Hechos posteriores al cierre del ejercicio" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">25. Hechos posteriores al cierre del ejercicio</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_5"></wk:observed-region-end></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">Los principales hechos ocurridos con posterioridad al cierre del ejercicio han sido los siguientes:</span></p><p class="Bodytext-f06626cf" style="font-size: 11pt;"><span class="C-Bodytext-acc173f9 C-Bodytext">Iberdrola Retribución Flexible</span></p><p class="Bodytext-f06626cf" style="font-size: 11pt;"><span class="C-Bodytext">El día </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_146"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="8 de enero de 2025" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">8 de enero de 2025</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_146"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_149"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">quedaron determinados los extremos que se resumen a continuación en relación con la ejecución del segundo aumento de capital liberado (</span><span class="C-Bodytext-e492cc84 C-Bodytext">Iberdrola Retribución Flexible</span><span class="C-Bodytext">) aprobado por la Junta General de Accionistas de IBERDROLA celebrada el</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_149"></wk:observed-region-end><span class="C-Bodytext">&#xa0; </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_153"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="17 de mayo de 2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">17 de mayo de 2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_153"></wk:observed-region-end><span class="C-Bodytext"> bajo el punto número trece de su orden del día: </span></p><p class="Bodytext-7a779bed" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 31.59pt;">El número máximo de acciones nuevas a emitir en virtud del aumento de capital es de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_289"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="109728465" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">109.728.465</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_289"></wk:observed-region-end><span class="C-Bodytext">.</span></p><p class="Bodytext-ba822f0c" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_293"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext" style="padding-left: 31.59pt;">El número de derechos de asignación gratuita necesarios para recibir una acción nueva es d</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_293"></wk:observed-region-end><span class="C-Bodytext">e </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_297"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="58" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." 