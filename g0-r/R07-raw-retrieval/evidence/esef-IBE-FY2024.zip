19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_8"></wk:observed-region-end></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">La preparación de estas Cuentas anuales ha requerido que IBERDROLA realice asunciones y efectúe estimaciones. Los principales aspectos objeto de estimación en la preparación de estas Cuentas anuales son los siguientes:</span></p><p class="Bodytext-6ef513db" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 14.15pt;">Provisión para pensiones y obligaciones similares:</span></p><p class="Bodytext-015ec4e7" style="font-size: 11pt;"><span class="C-Bodytext">IBERDROLA estima al cierre de cada ejercicio la provisión actual actuarial necesaria para hacer frente a los compromisos por planes de pensiones y otras obligaciones similares que ha contraído con sus trabajadores. En la elaboración de dichas estimaciones, IBERDROLA cuenta con el asesoramiento de actuarios independientes (Notas </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_611"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="4.7" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4.7</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_611"></wk:observed-region-end><span class="C-Bodytext"> </span><span class="C-Bodytext">y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_616"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="4.8" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4.8</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_616"></wk:observed-region-end><span class="C-Bodytext">).</span></p><p class="Bodytext-6ef513db" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 14.15pt;">Deterioro de inversiones en empresas del grupo y asociadas:</span></p><p class="Bodytext-015ec4e7" style="font-size: 11pt;"><span class="C-Bodytext">Tal como se describe en la Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_713"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="4.3" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4.3</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_713"></wk:observed-region-end><span class="C-Bodytext">, IBERDROLA, conforme a la normativa contable que le es de aplicación, realiza test de deterioro con carácter anual de aquellas inversiones que así lo requieren. Asimismo, realiza test específicos en el caso de detectar indicios para ello. Estos test de deterioro requieren la estimación de la evolución futura de los negocios y de la tasa de descuento más apropiada en cada caso. IBERDROLA cree que sus estimaciones en este sentido son adecuadas y coherentes con la actual coyuntura de los mercados.</span></p><p class="Bodytext-6ef513db" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 14.15pt;">Provisiones para riesgos y gastos:</span></p><p class="Bodytext-015ec4e7" style="font-size: 11pt;"><span class="C-Bodytext">Como se indica en la Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_1277"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="4.11" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4.11</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94/frag:9f71f90669a54e9fb3757ccdc80c46a5/textregion:9f71f90669a54e9fb3757ccdc80c46a5_1277"></wk:observed-region-end><span class="C-Bodytext">, IBERDROLA contabiliza provisiones en cobertura de las obligaciones presentes que surgen como resultado de sucesos pasados. Para ello tiene que evaluar el resultado de determinados procedimientos legales o de otro tipo que no están cerrados a fecha de formulación de las Cuentas anuales en función de la mejor información disponible.</span></p><p class="Bodytext-efbb799c" style="font-size: 11pt;"><span class="C-Bodytext">A pesar de que estas estimaciones se han realizado en función de la mejor información disponible en la fecha de formulación de estas Cuentas anuales, es posible que acontecimientos futuros obliguen a modificarlas (al alza o a la baja) en próximos períodos, lo que se haría de forma prospectiva, reconociendo los efectos del cambio de estimación en períodos futuros. </span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_94"></wk:section-end><wk:section-start hidden-section="false" name="7. Inmovilizado intangible" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_97102" style="position: absolute; top: 0pt;"></div><p class="Bodytext-8be9d3d7" style="font-size: 17pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.61pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.61pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:64fd503d5ae7450cb8d1946a7397a761/table:c8b7b55d5f71434086cd7e5b3b63b2bb"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:64fd503d5ae7450cb8d1946a7397a761/table:c8b7b55d5f71434086cd7e5b3b63b2bb"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 56.69pt; position: absolute; top: 18.51pt; width: 510.0400000000001pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 510.0400000000001pt;"><div style="margin-bottom: 0; margin-top: 0; padding-right: 18pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 471pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 240pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 203.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 27.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 41.25pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-c4234790" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_25/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d/tablerange:641afed77d0444e083eab6082ff7d49d_0-0-1-1-826894/textregion:b5f01ce7a62145a3b099fac5eeccee49_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_25/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d/tablerange:641afed77d0444e083eab6082ff7d49d_0-0-1-1-826894/textregion:b5f01ce7a62145a3b099fac5eeccee49_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">30</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-1" style="font-size: 17pt; margin-top: 0;"><span id="ieecaf05927494f2ca299bddcf8394017"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:aa670da3b66a4ad09a4853b3f92b3707/textregion:aa670da3b66a4ad09a4853b3f92b3707_6"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="7. Inmovilizado intangible" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">7. Inmovilizado intangible</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:aa670da3b66a4ad09a4853b3f92b3707/textregion:aa670da3b66a4ad09a4853b3f92b3707_6"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">La composición y movimientos del inmovilizado intangible en los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:aa670da3b66a4ad09a4853b3f92b3707/textregion:aa670da3b66a4ad09a4853b3f92b3707_84"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:aa670da3b66a4ad09a4853b3f92b3707/textregion:aa670da3b66a4ad09a4853b3f92b3707_84"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_97/frag:aa670da3b66a4ad09a4853b3f92b3707/textregion:aa670da3b66a4ad09a4853b3f92b3707_89"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negati