dth: 100%;"><p class="Heading-2" style="font-size: 14pt; margin-top: 0;"><span id="ice6dadf1d7c045ed8959682e3bfb62a3"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="11.5. Acciones propias" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">11.5. Acciones propias</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_5"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">La sociedad realiza operaciones de compra y venta de acciones propias de acuerdo con lo previsto en la normativa vigente y en los acuerdos adoptados por la Junta General de Accionistas. Las operaciones incluyen tanto la compraventa de acciones de IBERDROLA como la contratación de derivados sobre las mismas.</span></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">Los saldos de los diferentes instrumentos a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_380"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_380"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_385"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_385"></wk:observed-region-end><span class="C-Bodytext">, expresados en millones de euros,</span><span class="C-Bodytext"> son los siguientes:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/table:b2341262d94b4cc580af4b5869e0a44b"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 93.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 86.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 86.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 86.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 86.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-557c0529" style="padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 12pt; overflow: hidden;"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/table:b2341262d94b4cc580af4b5869e0a44b/tablerange:b2341262d94b4cc580af4b5869e0a44b_0-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="sin dato" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-3ca63523 C-Table-Normal">sin dato</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f1946