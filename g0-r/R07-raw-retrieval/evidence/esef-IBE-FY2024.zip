e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_145/frag:804a406fe1a54d458833b45d069934bc/table:a5336210973d47ff883cbb664b02fcc4"></wk:table-end></div><p class="Bodytext-0674991b" style="font-size: 9pt;"><span class="C-Bodytext-eb3f3597 C-Bodytext">(1)</span><span class="C-Bodytext-c3e5e06f C-Bodytext"> Estas acciones incluyen las entregadas a los directivos que son consejeros (Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_145/frag:804a406fe1a54d458833b45d069934bc/textregion:804a406fe1a54d458833b45d069934bc_374"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="21" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">21</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_145/frag:804a406fe1a54d458833b45d069934bc/textregion:804a406fe1a54d458833b45d069934bc_374"></wk:observed-region-end><span class="C-Bodytext-c3e5e06f C-Bodytext">).</span></p><p class="Bodytext-1d2fd272" style="font-size: 9pt;"><span class="C-Bodytext-eb3f3597 C-Bodytext">(2) </span><span class="C-Bodytext-c3e5e06f C-Bodytext">Impuestos repercutidos correspondientes a acciones entregadas a la alta dirección: 2,1 y 2,11 millones de euros correspondientes a la primera y segunda entrega del Bono Estratégico 2020-2022, respectivamente.</span></p><p class="Bodytext-dfbf7969" style="font-size: 11pt;"><span class="C-Bodytext-acc173f9 C-Bodytext">Plan de compensación a largo plazo en acciones en periodo de evaluación</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">En el ejercicio </span><span class="C-Bodytext">2023</span><span class="C-Bodytext"> la Junta General de Accionistas de IBERDROLA aprobó el siguiente plan de compensación a largo plazo en acciones:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_145/frag:804a406fe1a54d458833b45d069934bc/table:5e099a7fa21a4f09a24edd820d5f0a23"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 453pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 165pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 72pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 72pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 72pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 72pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 33.75pt;"><td class="cellStyle-d9963a49" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_145/frag:804a406fe1a54d458833b45d069934bc/table:5e099a7fa21a4f09a24edd820d5f0a23/tablerange:5e099a7fa21a4f09a24edd820d5f0a23_0-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Programa de compensación a largo plazo" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" un