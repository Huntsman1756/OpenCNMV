class="C-Bodytext">millones de euros. También acordó mantener en</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_24"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_26"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_26"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_28"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_28"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_30"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> el límite de la remuneración variable anual en</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_30"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_32"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_32"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_34"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="3.25" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">3,250</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_34"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_36"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_36"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_38"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">millones de euros.&#xa0; La retribución fija y la retribución variable anual se han mantenido inalteradas en los últimos catorce ejercicios. </span></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">El Consejo de Administración acordó una retribución fija anual en el ejercicio</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_38"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_40"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_40"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_42"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_42"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_44"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> para el Consejero Delegado de </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_44"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_46"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_46"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_48"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> millón de euros y estableció un límite de su retribución variable anual en </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_48"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_50"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="1" prefix="" raw-value="1.5" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1,5</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_50"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_52"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> millones de euros. </span></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">En ambos casos, la retribución variable anual será satisfecha, en la medida en que se acuerde, en el ejercicio </span><span class="C-Bodytext-209baf9d C-Bodytext">2025</span><span class="C-Bodytext"> en función de los objetivos fijados. </span></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">L</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_52"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_54"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">as remuneraciones satisfechas y devengadas por el Presidente ejecutivo y por el Consejero Delegado durante los ejercicios</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_54"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_56"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_56"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_58"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_58"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_60"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> y </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_60"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_62"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_62"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_64"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-209baf9d C-Bodytext">, expresadas en millones de euros,</span><span class="C-Bodytext"> </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_64"