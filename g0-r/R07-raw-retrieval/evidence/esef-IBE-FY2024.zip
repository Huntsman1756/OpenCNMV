gion-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_121"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="7" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">7</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_121"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_126"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="11" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">11</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_126"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, respectivamente, correspondientes a contratos de arrendamiento operativo. El total de los pagos futuros mínimos no descontados por arrendamientos operativos no cancelables vigentes a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_350"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_350"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_205/frag:64fa8ae6f4434e4b97d183572aaaff70/textregion:64fa8ae6f4434e4b97d183572aaaff70_355"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-se