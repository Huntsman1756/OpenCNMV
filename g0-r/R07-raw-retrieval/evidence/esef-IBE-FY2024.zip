0b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/table:3981c28c6e2c4ab0983ab69902cfe740/tablerange:3981c28c6e2c4ab0983ab69902cfe740_8-2-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="-6" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">(6)</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/table:3981c28c6e2c4ab0983ab69902cfe740/tablerange:3981c28c6e2c4ab0983ab69902cfe740_8-2-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/table:3981c28c6e2c4ab0983ab69902cfe740"></wk:table-end></div><p class="Bodytext-76c8d55f" style="font-size: 11pt;"><span class="C-Bodytext">Las diferencias permanentes corresponden principalmente a los dividendos recibidos (Nota 18.1), a las variaciones de correcciones valorativas de participaciones en empresas del grupo y asociadas para las que no se ha registrado un activo por impuesto diferido (Nota 10) y a otros gastos que no tienen la consideración de fiscalmente deducibles.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Las diferencias temporarias más relevantes derivan del efecto fiscal de los gastos registrados por compromisos por pensiones y los gastos derivados de planes de reestructuración y otras provisiones.</span></p><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-b