"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">67</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-end></div><p class="Bodytext-3af96eee" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext" style="font-size: 11pt; margin-top: 0;"><span><br /></span></p><p class="Heading-2" style="font-size: 14pt;"><span id="i082f666eaa5d4fcc8d8293081abbdbad"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/textregion:94d3071ada0a4dbf91ea62af8b00ec87_2676"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="17.3. Gasto contable por impuesto sobre beneficios" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">17.3. Gasto contable por impuesto sobre beneficios</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/textregion:94d3071ada0a4dbf91ea62af8b00ec87_2676"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">La composición del Impuesto sobre Sociedades entre impuestos corrientes y diferidos, expresada en millones de euros, es la siguiente:</span></p><div style="margin-bottom: 12pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/table:28a34c1122d743738b858322e0f2a663"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 439.5pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 156pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 141.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 141.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-557c0529" style="padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/table:28a34c1122d743738b858322e0f2a663/tablerange:28a