-region-end></p></td><td class="cellStyle-e91aea7b" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 0.5pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/table:49b6f27ff30844969fb62ddea25dc768/tablerange:49b6f27ff30844969fb62ddea25dc768_14-5-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="0" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="1" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">0</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/table:49b6f27ff30844969fb62ddea25dc768/tablerange:49b6f27ff30844969fb62ddea25dc768_14-5-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/table:49b6f27ff30844969fb62ddea25dc768"></wk:table-end></div><p class="Bodytext-7315c71d" style="font-size: 11pt;"><span class="C-Bodytext">Adicionalmente, del reparto de reservas aprobado por Iberdrola España, S.A. en el ejercicio 2.034 millones de euros han minorado el valor contable de la inversión, al tratarse de una recuperación de parte de la misma (Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_823"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="10" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">10</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_823"></wk:observed-region-end><span class="C-Bodytext">).</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259"></wk:section-end><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_253"></wk:section-end><wk:section-start hidden-section="false" name="24.	Honorarios por servicios prestados por los auditores de cuentas" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_262"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_262102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 17pt;"><span id="i18e15b464afb471f9fe4702a8ce0257a"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_262/frag:d651502e43a84747b6f76476569404ee/textregion:d651502e43a84747b6f76476569404ee_5"><wk:value-format currency-symbol="" decimal-