observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/table:fe1abbf133bc4ff6aab4fba1c552cec0/tablerange:fe1abbf133bc4ff6aab4fba1c552cec0_13-2-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="0.698" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">0,698</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/table:fe1abbf133bc4ff6aab4fba1c552cec0/tablerange:fe1abbf133bc4ff6aab4fba1c552cec0_13-2-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/table:fe1abbf133bc4ff6aab4fba1c552cec0"></wk:table-end></div><p class="Bodytext" style="font-size: 9pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_190"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">(*) Además del Presidente ejecutivo y el Consejero Delegado.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_190"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 8pt;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_194"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">El Bono Estratégico 2023-2025 fue aprobado por la Junta General de Accionistas de 28 de abril de 2023 cuyo detalle figura en la Nota</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_194"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_197"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="12" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">12</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_197"></wk:observed-region-end><span class="C-Bodytext">.</span><span class="C-Bodytext"> </span></p><p class="Bodytext" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_202"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">Las cláusulas de indemnización se describen en los apartados 6.3 y C.1.39 del Informe Anual de Gobierno Corporativo incluido en el Informe de Gestión.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">Por otro lado, durante los ejercicios </span><span class="C-Bodytext-209baf9d C-Bodytext">2024</span><span class="C-Bodytext"> y </span><span class="C-Bodytext-209baf9d C-Bodytext">2023</span><span class="C-Bodytext"> no se han producido operaciones vinculadas con el equipo directivo.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:c5ad64f600f24017b21b21eb4219949b/textregion:c5ad64f600f24017b21b21eb4219949b_202"></wk:observed-region-end></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 292.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 146.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-end></div></div></div></wk:footer><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_247"></wk:section-end></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:section-start hidden-section="false" name="22.	Información sobre el cumplimiento del artículo 229  de la Ley de Sociedades de Capital" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_250102" style="position: absolute; top: 0pt;"></div><wk:header><div style="height: 85.05pt; left: 70.87pt; position: absolute; top: 40.17pt; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 246.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 166.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 25.5pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">89</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-1" style="font-size: 17pt; margin-top: 0;"><span id="ia130616a22814eef9e625bd175ce7ca4"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:80fbe08adffd4672a646323454751015/textregion:80fbe08adffd4672a646323454751015_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="22. Información sobre el cumplimiento del artículo 229 de la Ley de Sociedades de Capital" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">22. Información sobre el cumplimiento del artículo 229 de la Ley de Sociedades de Capital</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:80fbe08adffd4672a646323454751015/textregion:80fbe08adffd4672a646323454751015_5"></wk:observed-region-end></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:80fbe08adffd4672a646323454751015/textregion:80fbe08adffd4672a646323454751015_8"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">De conformidad con lo establecido en el artículo 229 de la Ley de Sociedades de Capital introducido por el Real Decreto-ley 1/2010 de 2 de julio de 2010 y con la Ley 31/2014 de 3 de diciembre de 2014, por la que se modifica la Ley de Sociedades de Capital para la mejora del gobierno corporativo, se señalan a continuación las situaciones de conflicto de interés en las que han incurrido los administradores.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">El presidente ejecutivo y el consejero delegado se ausentaron durante la deliberación de todos los acuerdos relativos a sus contratos, incluyendo sus respectivas remuneraciones.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">El señor Sagredo Ormaza se abstuvo de intervenir en los acuerdos concernientes a Kutxabank, S.A. y, en concreto, en la contratación de Norbolsa Sociedad de Valores, S.A. como entidad agente en relación con el sistema de dividendo opcional </span><span class="C-Bodytext-e492cc84 C-Bodytext">Iberdrola Retribución Flexible</span><span class="C-Bodytext">. La señora García Tejerina se abstuvo de participar en las deliberaciones sobre la venta de un proindiviso por una sociedad del Grupo Iberdrola a una sociedad en la que posee una participación minoritaria.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250/frag:80fbe08adffd4672a646323454751015/textregion:80fbe08adffd4672a646323454751015_8"></wk:observed-region-end></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span><br /></span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_250"></wk:section-end><wk:section-start hidden-section="false" name="23.	Saldos y operaciones con partes vinculadas" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_253"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_253102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 17pt;"><span id="i9b3239bab3be41e49b63059df5f1157f"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_253/frag:ad083a0ad1ec468f85e69153e8e754cc/textregion:ad083a0ad1ec468f85e69153e8e754cc_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="23. Saldos y operaciones con partes vinculadas" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">23. Saldos y operaciones con partes vinculadas</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_253/frag:ad083a0ad1ec468f85e69153e8e754cc/textregion:ad083a0ad1ec468f85e69153e8e754cc_5"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">Las operaciones que se detallan a continuación son propias del giro o tráfico ordinario y han sido realizadas en condiciones normales de mercado.</span></p><wk:section-start hidden-section="false" name="23.1	Saldos de IBERDROLA con empresas del grupo y asociadas " wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_256102" style="position: absolute; top: 0pt;"></div><p class="Heading-2" style="font-size: 14pt;"><span id="ib032c1a3d0554ee597600338aaa947df"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="23.1. Saldos de IBERDROLA con empresas del grupo y asociadas" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">23.1. Saldos de IBERDROLA con empresas del grupo y asociadas</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_5"></wk:observed-region-end></p><p class="Normal-green-titles-82e8f980" style="font-size: 12pt;"><span class="C-Bodytext-fe718ca0 C-Bodytext">a)</span><span class="C-Normal-green-titles" style="padding-left: 7.34pt;">Saldos financieros con empresas del grupo y asociadas</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext-7d780659 C-Bodytext">Créditos a empresas del grupo y asociadas </span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">El detalle de la cuenta “Créditos a empresas del grupo y asociadas” a corto y largo plazo del Balance a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_229"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_229"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_234"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/textregion:3bae7fb76ee04b5bab5d57f0a0b5585f_234"></wk:observed-region-end><span class="C-Bodytext">, expresado en millones de euros, </span><span class="C-Bodytext">es el siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:6276da1c4ac04832afb9f9490ee8e82b"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 449.25pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 138.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 51.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-147e505d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="2" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><span class="C-Table-Normal-d0b3ba93 C-Table-Normal">sin dato</span></p></td><td class="cellStyle-d9963a49" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="3"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:6276da1c4ac04832afb9f9490ee8e82b/tablerange:6276da1c4ac04832afb9f9490ee8e82b_0-1-1-1-826894"><wk:value-format currency-s