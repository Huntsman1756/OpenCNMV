onsumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-e796def9 C-Table-Normal"></span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_298/frag:49501685caff494a81fa2a0689a67654/table:677d9b0da6b149248c44954633cdd92f/tablerange:677d9b0da6b149248c44954633cdd92f_19-5-1-1-826894"></wk:observed-region-end></p></div></td><td class="cellStyle-af6d6e7d" style="padding-top: 0;" rowspan="1" colspan="1"><div style="height: 11.25pt; overflow: hidden;"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_298/frag:49501685caff494a81fa2a0689a67654/table:677d9b0da6b149248c44954633cdd92f/tablerange:677d9b0da6b149248c44954633cdd92f_19-6-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-e796def9 C-Table-Normal"></span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_298/frag:49501685caff494a81fa2a0689a67654/table:677d9b0da6b149248c44954633cdd92f/tablerange:677d9b0da6b149248c44954633cdd92f_19-6-1-1-826894"></wk:observed-region-end></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_298/frag:49501685caff494a81fa2a0689a67654/table:677d9b0da6b149248c44954633cdd92f"></wk:table-end></div><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_298"></wk:section-end><wk:section-start hidden-section="false" name="6.	Hechos posteriores" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_301"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_301102" style="position: absolute; top: 0pt;"></div><p class="Bodytext-599b01ec" style="font-size: 17pt;"><span><br /></span></p><p class="Heading-1-d4ca3bcf" style="font-size: 17pt;"><span id="id31b3c998fca496880faa20cb05cdc2f"></span><span class="C-Heading-1">6.&#xa0;&#xa0;&#xa0;&#xa0;Hechos posteriores</span></p><p class="Bodytext-e8aebdde" style="font-size: 11pt;"><span class="C-Bodytext">Los hechos posteriores al cierre del ejercicio se describen en la Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_301/frag:7820138be26144efb76fd608700856ae/textregion:7820138be26144efb76fd608700856ae_99"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="25" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">25</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_301/frag:7820138be26144efb76fd608700856ae/textregion:7820138be26144efb76fd608700856ae_99"></wk:observed-region-end><span class="C-Bodytext"> de la Memoria.</span></p><p class="Bodytext-43467857" style="font-size: 11pt;"><span><br /></span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_301"></wk:section-end><wk:section-start hidden-section="false" name="7. IAGC" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_304102" style="position: absolute; top: 0pt;"></div><p class="Heading-1-a2deb17f" style="font-size: 17pt;"><span id="i4f45aa3dafdc4e6ca1db7b6e66caefec"></span><span class="C-Heading-1">7.&#xa0;&#xa0;&#xa0;&#xa0;Informe Anual de Gobierno Corporativo </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_46"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_46"></wk:observed-region-end></p><p class="Bodytext-ad82e067" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_455"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">De conformidad con lo dispuesto en el artículo 538 de la Ley de Sociedades de Capital, este informe de gestión incorpora por referencia el texto íntegro del “Informe anual de gobierno corporativo </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_455"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_245"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_245"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_452"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">” aprobado por el Consejo de Administración de “Iberdrola, S.A.” y publicado en la página web de la Comisión Nacional del Mercado de Valores (</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_452"></wk:observed-region-end><span class="C-Bodytext-e324dc9d C-Bodytext"><a class="Hyperlink" href="http://www.cnmv.es102">www.cnmv.es</a></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_453"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">) y en la página web corporativa (</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_453"></wk:observed-region-end><span class="C-Bodytext-e324dc9d C-Bodytext"><a class="Hyperlink" href="http://www.iberdrola.com102">www.iberdrola.com</a></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_454"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">).</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304/frag:ba2f10f99b9646bb974d84556d90b196/textregion:ba2f10f99b9646bb974d84556d90b196_454"></wk:observed-region-end></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_304"></wk:section-end><wk:section-start hidden-section="false" name="8. IARC" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_307102" style="position: absolute; top: 0pt;"></div><p class="Heading-1-2d8e6202" style="font-size: 17pt;"><span id="i7815e57d4b6543b6b610ca12003e9b82"></span><span class="C-Heading-1">8. Informe Anual sobre Remuneraciones de los Consejeros </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_61"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_61"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_496"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">De conformidad con lo dispuesto en el artículo 538 de la Ley de Sociedades de Capital, este informe de gestión incorpora por referencia el texto íntegro del “Informe anual sobre remuneraciones de los consejeros y directivos </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_496"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_288"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_288"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_497"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">” aprobado por el Consejo de Administración de “Iberdrola, S.A.” y publicado en la página web de la Comisión Nacional del Mercado de Valores (</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_497"></wk:observed-region-end><span class="C-Bodytext-e324dc9d C-Bodytext"><a class="Hyperlink" href="http://www.cnmv.es102">www.cnmv.es</a></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_498"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">) y en la página web corporativa (</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_498"></wk:observed-region-end><span class="C-Bodytext-e324dc9d C-Bodytext"><a class="Hyperlink" href="http://www.iberdrola.com102">www.iberdrola.com</a></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_499"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">).</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:e041da35fc4848b797fe7b23526df1aa/textregion:e041da35fc4848b797fe7b23526df1aa_499"></wk:observed-region-end></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 292.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 146.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 70.87pt; position: absolute; top: 40.17pt; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 246.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 166.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 25.5pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c/tablerange:20d7371a29704af7a980403896bbf53c_0-0-1-1-826894/textregion:9034f9057ab44fb584495182af74a4d3_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">108</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307/frag:b3e1c0008de44fee93ffdc3387cd6ca7/table:20d7371a29704af7a980403896bbf53c"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext" style="font-size: 11pt; margin-top: 0;"><span><br /></span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_307"></wk:section-end><wk:section-start hidden-section="false" name="9.	Información no financiera y diversidad" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_310102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 17pt;"><span id="i0d9d96557655469097730ee4a2a8f0bd"></span><span class="C-Heading-1">9.&#xa0;&#xa0;&#xa0;&#xa0;Información no financiera</span></p><p class="Bodytext-7fe260c5" style="font-size: 11pt;"><span class="C-Bodytext">IBERDROLA es una sociedad </span><span class="C-Bodytext-e492cc84 C-Bodytext">holding:</span><span class="C-Bodytext"> en consecuencia, no existen partidas de naturaleza medioambiental que deban ser incluidas en la Memoria de acuerdo con lo requerido por el Plan General de Contabilidad.</span></p><p class="Bodytext-7fe260c5" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">La Sociedad, así como sus dependientes, se encuentran dispensadas de presentar el </span><span class="C-Bodytext-e492cc84 C-Bodytext">Estado de información no financiera</span><span class="C-Bodytext">, al que se refieren los artículos 262 de la Ley de Sociedades de Capital y 49 del Código de Comercio, al estar incluidas en el informe separado denominado </span><span class="C-Bodytext-e492cc84 C-Bodytext">Estado de información no financiera. Informe de sostenibilidad consolidado de IBERDROLA, S.A. y sus sociedades dependientes correspondiente al ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310/frag:5422555649d4436b9c18c7c8bd57ec42/textregion:5422555649d4436b9c18c7c8bd57ec42_664"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-e492cc84 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310/frag:5422555649d4436b9c18c7c8bd57ec42/textregion:5422555649d4436b9c18c7c8bd57ec42_664"></wk:observed-region-end><span class="C-Bodytext">, tanto la Sociedad como sus empresas del grupo. Dicho documento ha sido objeto de verificación por un prestador independiente de servicios de verificación y está sometido a los mismos criterios de aprobación, depósito y publicación que el Informe de gestión consolidado del Grupo IBERDROLA.</span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 292.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 146.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-end></div></div></div></wk:footer><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_310"></wk:section-end><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_274"></wk:section-end><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_271"></wk:section-end></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:section-start hidden-section="false" name="Propuesta de aplicación del resultado" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_313"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_313102" style="p