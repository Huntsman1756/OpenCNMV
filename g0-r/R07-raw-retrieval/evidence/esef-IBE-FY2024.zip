argin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/table:13463b13edb648b2967dbea2e5bee386/tablerange:13463b13edb648b2967dbea2e5bee386_17-11-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="7.206" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="1" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header-Text-cde29221 C-Header-Text">7,206</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/table:13463b13edb648b2967dbea2e5bee386/tablerange:13463b13edb648b2967dbea2e5bee386_17-11-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-e91aea7b" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text-0fde191c" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/table:13463b13edb648b2967dbea2e5bee386/tablerange:13463b13edb648b2967dbea2e5bee386_17-12-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header-Text-3edea17d C-Header-Text"></span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/table:13463b13edb648b2967dbea2e5bee386/tablerange:13463b13edb648b2967dbea2e5bee386_17-12-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/table:13463b13edb648b2967dbea2e5bee386"></wk:table-end></div><p class="Bodytext-9bb5126f" style="font-size: 8pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/textregion:d1be85158e6c4c9792a32fb03d97d115_7"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-d2c8d7b2 C-Bodytext">(1)</span><span class="C-Bodytext-bad27e37 C-Bodytext"> Retribución devengada en el ejercicio 2024 que se corresponde con el tiempo en el ejercicio de su cargo. Este importe no es satisfecho hasta la aprobación de las Cuentas anuales del ejercicio 2024 por la Junta General de Accionistas de 2025.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_241/frag:d1be85158e6c4c9792a32fb03d97d115/textregion:d1be85158e6c4c9792a32fb03d97d115_7"></wk:observed-region-end></p><p class="Bodytext-3de74f9e" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 742.68pt;"><div style="bottom: 0;