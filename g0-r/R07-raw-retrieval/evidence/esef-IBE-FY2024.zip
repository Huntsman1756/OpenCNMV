6ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 63.77pt; position: absolute; top: 18.51pt; width: 488.43pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 488.43pt;"><div style="margin-bottom: 8pt; margin-top: 0; padding-right: 18pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-top: 2pt; vertical-align: text-bottom; width: 459.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 242.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 32.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">64</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-end></div><p class="Bodytext-3af96eee" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-2" style="font-size: 14pt; margin-top: 0;"><span id="i1be5ed69041648dc9c472510f122002e"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/textregion:94d3071ada0a4dbf91ea62af8b00ec87_6"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="17.2. Impuesto sobre beneficios" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">17.2. Impuesto sobre beneficios</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:94d3071ada0a4dbf91ea62af8b00ec87/textregion:94d3071ada0a4dbf91ea62af8b00ec87_6"></wk:observed-region-end></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">IBERDROLA es sociedad dominante de dos grupos de consolidación fiscal en territorio español: el grupo 2/86, de territorio común, y el grupo 02415BSC, de territorio foral vizcaíno. IBERDROLA se integra en el segundo de los citados grupos.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">El grupo 2/86 está constituido por 95 sociedades, mientras que en el grupo 02415BSC se incluyen 27 sociedades.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">En ejercicios anteriores, IBERDROLA participó en operaciones de reestructuración societaria sometidas al régimen especial de neutralidad fiscal regulado actualmente en el Capítulo VII del Título VII de la Ley 27/2014, de 27 de noviembre, del Impuesto sobre Sociedades. Los requisitos de información establecidos por la citada norma figuran en las Memorias que forman parte de las Cuentas anuales correspondientes a los ejercicios en que se han realizado dichas operaciones.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext-7d780659 C-Bodytext">Tributación en el resto de países</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Las demás sociedades del Grupo, residentes fuera de territorio español, tributan aplicando el tipo de gravamen del impuesto sobre beneficios respectivo de su jurisdicción de residencia. En Estados Unidos, Reino Unido, Francia, Australia, Italia, Rumanía y Portugal las sociedades que cumplen los requisitos para ello aplican un régimen de tributación conjunta.&#xa0; En el resto de jurisdicciones, las entidades del grupo con presencia fiscal en las mismas tributan en régimen individual.</span></p><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">Los tipos de gravamen nominales aplicables en las jurisdicciones en que tiene presencia el Grupo IBERDROLA son los siguientes (datos OCDE, incluyendo el tipo federal/general y, en su caso, estatal/local):</span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_175/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Norma