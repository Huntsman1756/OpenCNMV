." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_151/frag:24182ea1895346ab997446e090f543bb/textregion:24182ea1895346ab997446e090f543bb_2442"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_151/frag:24182ea1895346ab997446e090f543bb/textregion:24182ea1895346ab997446e090f543bb_2447"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_151/frag:24182ea1895346ab997446e090f543bb/textregion:24182ea1895346ab997446e090f543bb_2447"></wk:observed-region-end><span class="C-Bodytext"> de la provisión contabilizada para hacer frente a los compromisos indicados en el apartado anterior, expresado en millones de euros, es el siguiente:</span></p><div style="margin-bottom: 15pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_151/frag:24182ea1895346ab997446e090f543bb/table:38d27ec5d8