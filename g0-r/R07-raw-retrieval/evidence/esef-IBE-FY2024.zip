8ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/table:f5982dd1759446e7adc005bcf2d6835d"></wk:table-end></div><p class="Bodytext-b51b868e" style="font-size: 11pt;"><span class="C-Bodytext">Los resultados obtenidos por IBERDROLA en los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_646"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_646"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_651"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_651"></wk:observed-region-end><span class="C-Bodytext"> en las transacciones con acciones propias han ascendido a un beneficio de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_728"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="4" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_728"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_733"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="14" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">14</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_733"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, respectivamente, que figuran registrados en el epígrafe “Reservas - Otras reservas” del Balance.</span></p><p class="Normal-green-titles-a5e1e723" style="font-size: 12pt;"><span class="C-Bodytext-fe718ca0 C-Bodytext">b)</span><span class="C-Normal-green-titles" style="padding-left: 9.98pt;">Derivados con liquidación física</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">IBERDROLA ha registrado estas operaciones con cargo a patrimonio en el epígrafe “Acciones y participaciones en patrimonio propias” y un pasivo por la obligación de compra de dichas acciones que figura registrado en el epígrafe “Deudas a corto plazo – Deudas con entidades de crédito” del pasivo del Balance.</span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:d46f8af84d1747b78dd847ffde2bf49d/table:3a0964ad377749c5a7c8c21adb49a251"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:d46f8af84d1747b78dd847ffde2bf49d/table:3a0964ad377749c5a7c8c21adb49a251"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 63.78pt; position: absolute; top: 32.19pt; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 462pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 246pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 30.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73/tablerange:2dd49fb5e79b447fbbe6ad1f14a43e73_0-0-1-1-826894/textregion:2204661075e84f36bc1f70bbb2bdd553_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73/tablerange:2dd49fb5e79b447fbbe6ad1f14a43e73_0-0-1-1-826894/textregion:2204661075e84f36bc1f70bbb2bdd553_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">49</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext" style="font-size: 11pt; margin-top: 0;"><span><br /></span></p><p class="Bodytext-6ef513db" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext-c658ebdd C-Bodytext" style="padding-left: 14.15pt;">Permutas sobre acciones propias (</span><span class="C-Bodytext-7fc19100 C-Bodytext">total return swaps</span><span class="C-Bodytext-c658ebdd C-Bodytext">)</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">IBERDROLA posee </span><span class="C-Bodytext-e492cc84 C-Bodytext">swaps</span><span class="C-Bodytext"> (permutas) sobre acciones propias por las cuales durante la vida del contrato pagará a la entidad financiera Euribor a tres meses más un diferencial </span><span class="C-Bodytext-e492cc84 C-Bodytext">(spread)</span><span class="C-Bodytext"> sobre el nocional y recibirá los dividendos correspondientes a las acciones que cobre la entidad financiera. En la fecha de vencimiento comprará las acciones al precio de ejercicio fijado en el contrato. </span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Las características de estos contratos a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_1692"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_1692"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_1697"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:da7eb237d5c144d292116724f5fbcd99/textregion:da7eb237d5c144d292116724f5fbcd99_1697"></wk:observed-region-end><span class="C-Bodytext"> se describen en los siguientes cuadros:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f1946