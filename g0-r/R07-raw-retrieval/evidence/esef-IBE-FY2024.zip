om: 0; margin-top: 0; position: absolute; top: 0; width: 488.43pt;"><div style="margin-bottom: 8pt; margin-top: 0; padding-right: 18pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_178/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-top: 2pt; vertical-align: text-bottom; width: 459.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 242.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 32.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 39.75pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602/tablerange:332d1039395241999469f45f55f3f602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">68</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_178/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-end></div><p class="Bodytext-3af96eee" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext" style="font-size: 11pt; margin-top: 0;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Las diferencias permanentes corresponden principalmente a los dividendos recibidos (Nota 18.1), a las variaciones de correcciones valorativas de participaciones en empresas del grupo y asociadas para las que no se ha registrado un activo por impuesto diferido (Nota 10) y a otros gastos que no tienen la consideración de fiscalmente deducibles.</span></p><p class="Bodytext-8d59b7ef" style="font-size: 12pt;"><span><br /></span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_178"></wk:section-end><wk:section-start hidden-section="false" name="17.4 Impuestos diferidos" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_181102" style="position: absolute; top: 0pt;"></div><p class="Heading-2" style="font-size: 14pt;"><span id="ic71baee2716c4eadab0a2df92b36d69b"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="17.4. Impuestos diferidos" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">17.4. Impuestos diferidos</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_5"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">El movimiento de los “Activos por impuesto diferido” y de los “Pasivos por impuesto diferido” para los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_122"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_122"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_127"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec909d43f2b4992a1b/textregion:bb944c285b1941ec909d43f2b4992a1b_127"></wk:observed-region-end><span class="C-Bodytext">, expresado en millones de euros, es el siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_181/frag:bb944c285b1941ec9