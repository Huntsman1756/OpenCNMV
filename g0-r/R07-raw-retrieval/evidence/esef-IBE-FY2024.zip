0e90b48ff148f8a7f19466ba68bda9_22/frag:acba549947034fd49532f5dcc66bcad0/textregion:acba549947034fd49532f5dcc66bcad0_333"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_22/frag:acba549947034fd49532f5dcc66bcad0/textregion:acba549947034fd49532f5dcc66bcad0_333"></wk:observed-region-end><span class="C-Bodytext-c3e5e06f C-Bodytext"> se presenta, única y exclusivamente, a efectos comparativos.</span></p><p class="Bodytext-61808c9f" style="font-size: 9pt; margin-bottom: 0;"><span class="C-Bodytext-c3e5e06f C-Bodytext"> Las Notas descritas en la Memoria forman parte integrante del Estado de cambios en el patrimonio neto correspondiente al ejercicio anual terminado el 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_22/frag:acba549947034fd49532f5dcc66bcad0/textregion:acba549947034fd49532f5dcc66bcad0_567"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-c3e5e06f C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_22/frag:acba549947034fd49532f5dcc66bcad0/textregion:acba549947034fd49532f5dcc66bcad0_567"></wk:observed-region-end><span class="C-Bodytext-c3e5e06f C-Bodytext">.</span></p></div></div><wk:footer><div style="bottom: 19.84pt; height: 56.69pt; left: 70.87pt; position: absolute; width: 728.61pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 728.61pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_22/frag:1ac826e5369d46978fb78caa5585064a/table:7fdca191d5174759ba5312ae91e7c338"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 700.5pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 428.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 272.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -1.42pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 22.6pt; position: relative; top: 0.5749999999999993pt; width: 65.2pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_22