Heading-1">Cuenta de Pérdidas y Ganancias correspondiente al ejercicio anual terminado el 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_16/frag:f81c7daadbcb4d109bda1b0abc4970d5/textregion:f81c7daadbcb4d109bda1b0abc4970d5_104"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_16/frag:f81c7daadbcb4d109bda1b0abc4970d5/textregion:f81c7daadbcb4d109bda1b0abc4970d5_104"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 10pt;"><span class="C-Bodytext">Se muestra a continuación la Cuenta de Pérdidas y Ganancias a 31 de diciembre de 2024 y 2023, expresada en millones de euros: </span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_16/frag:f81c7daadbcb4d109bda1b0abc4970d5/table:044a877d3b144482b3673e3dd2903a81"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 453pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 267.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 48.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 68.25pt;" rowspan="1" colspan="1"></td><td style="pad