ives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-9daa552d C-Table-Normal">sin dato</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_5-1-1-1-826894"></wk:observed-region-end></p></div></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-92195b3c" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_6-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="A reserva legal" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">A reserva legal</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_6-0-1-1-826894"></wk:observed-region-end></p></div></td><td class="cellStyle-de87bd20" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_6-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="2" prefix="" raw-value="0" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">—</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_6-1-1-1-826894"></wk:observed-region-end></p></div></td></tr><tr style="height: 110.25pt;"><td class="cellStyle-92195b3c" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_7-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="A dividendos" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">A dividendos</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_7-0-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-92195b3c" style="padding-bottom: 0; padding-left: 0.18999999999999995pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_7-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Importe pendiente de determinar que resultará de sumar: (a) el Dividendo a Cuenta Total y (b) el producto que resulte de multiplicar el Dividendo Complementario por el número total de acciones respecto de las cuales sus titulares hayan optado por recibir el Dividendo complementario en el marco de la primera ejecución del sistema de dividendo opcional Iberdrola retribución flexible del ejercicio 2025." scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">Importe pendiente de determinar que resultará de sumar: (a) el Dividendo a Cuenta Total y (b) el producto que resulte de multiplicar el Dividendo Complementario por el número total de acciones respecto de las cuales sus titulares hayan optado por recibir el Dividendo complementario en el marco de la primera ejecución del sistema de dividendo opcional Iberdrola retribución flexible del ejercicio 2025.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_7-1-1-1-826894"></wk:observed-region-end></p></td></tr><tr style="height: 38.25pt;"><td class="cellStyle-92195b3c" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_8-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="A remanente" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">A remanente</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_8-0-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-92195b3c" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_8-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Importe determinable que resultará de restar a la base de reparto total el importe destinado a dividendo" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal">Importe determinable que resultará de restar a la base de reparto total el importe destinado a dividendo</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_8-1-1-1-826894"></wk:observed-region-end></p></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-e91aea7b" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="Table-Normal" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_9-0-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="Total" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">Total</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_9-0-1-1-826894"></wk:observed-region-end></p></div></td><td class="cellStyle-e91aea7b" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 13.5pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_9-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="2" prefix="" raw-value="17613708611.97" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">17.613.708.611,97</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3/tablerange:edfb6d49cddc49fea744850c65bce3c3_9-1-1-1-826894"></wk:observed-region-end></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/table:edfb6d49cddc49fea744850c65bce3c3"></wk:table-end></div><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Sujeto a la aprobación por la Junta General de Accionistas de los acuerdos correspondientes al sistema de dividendo opcional </span><span class="C-Bodytext-e492cc84 C-Bodytext">Iberdrola Retribución Flexible</span><span class="C-Bodytext"> correspondiente al ejercicio 2025 se estima que el importe del </span><span class="C-Bodytext-e492cc84 C-Bodytext">Dividendo Complementario</span><span class="C-Bodytext"> será de, al menos </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/textregion:9d581952b0d747289003dcd26c926736_322"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="0.404" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">0,404</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:9d581952b0d747289003dcd26c926736/textregion:9d581952b0d747289003dcd26c926736_322"></wk:observed-region-end><span class="C-Bodytext"> euros brutos por acción. El importe final del </span><span class="C-Bodytext-e492cc84 C-Bodytext">Dividendo Complementario</span><span class="C-Bodytext"> se comunicará tan pronto como el Consejo de Administración (o el órgano en que este delegue) lo determine de acuerdo con lo dispuesto en los términos de los acuerdos de distribución del dividendo y de aumento de capital que el Consejo de Administración propondrá a la Junta General de Accionistas en relación con el sistema de dividendo opcional </span><span class="C-Bodytext-e492cc84 C-Bodytext">Iberdrola Retribución Flexible</span><span class="C-Bodytext"> correspondiente al ejercicio 2025. Asimismo, una vez concluida la primera ejecución del sistema de dividendo opcional </span><span class="C-Bodytext-e492cc84 C-Bodytext">Iberdrola Retribución Flexible</span><span class="C-Bodytext"> correspondiente al ejercicio 2025, el Consejo de Administración (con expresa facultad de sustitución) procederá a concretar la propuesta de distribución anterior, determinando el importe definitivo del dividendo y la cantidad que se destinará a remanente.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 19.84pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.61pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.61pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:fbf1a5842c6c44c0be022621e6621f66/table:3ee3ffa380c14c6787d1048428307e1b"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.55pt; position: relative; top: -0.40000000000000036pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_316/frag:fbf1a5842c6c44c0be022621e6621f66/table:3ee3ffa380c14c6787d1048428307e1b"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 70.87pt; position: absolute; top: 40.17pt; width: 453