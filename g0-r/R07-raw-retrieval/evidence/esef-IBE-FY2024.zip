3/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2269"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2269"></wk:observed-region-end><span class="C-Bodytext"> mejora </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2279"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="8" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">8</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2279"></wk:observed-region-end><span class="C-Bodytext"> millones de euros respecto al ejercicio anterior, lo que se explica, fundamentalmente, por el </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2376"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="aumento" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">aumento</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2376"></wk:observed-region-end><span class="C-Bodytext"> de los ingresos financieros en </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_283/frag:2079333c5d83436a9f8d2af98516076f/textregion:2079333c5d83436a9f8d2af98516076f_2410"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="16" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"