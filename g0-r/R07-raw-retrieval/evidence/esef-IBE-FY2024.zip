alse" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">20.2. Otros gastos del Consejo de Administración</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_5"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_8"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">Asimismo, la mencionada asignación ha soportado otros gastos relacionados con el Consejo de Administración: </span></p><p class="Bodytext-bac0927d" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">a.</span><span class="C-Bodytext" style="padding-left: 8.84pt;">El importe de la prima del Seguro Colectivo de Responsabilidad Civil, por el ejercicio del cargo de consejero, que ha alcanzado los </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_8"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_10"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="3" prefix="" raw-value="0.168" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">0,168</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_10"></wk:observed-region-end><span class="C-Bodytext"> millones de euros en el ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_47"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag:ab47e398e2284ffcafba0ad748f15b52/textregion:ab47e398e2284ffcafba0ad748f15b52_47"></wk:observed-region-end><span class="C-Bodytext">, mientras que en </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_244/frag