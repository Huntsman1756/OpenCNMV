34/frag:1fd217b455274de1abe785fc8646afde/table:5cbe85ef3c6e4d52b3628002a452e182"></wk:table-end></div><p class="Heading-2-eed8f987" style="font-size: 14pt;"><span id="i4883a0cba7714db99652d21c1b35c626"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1045"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="2.2. Imagen fiel" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">2.2. Imagen fiel</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1045"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Las Cuentas anuales se han preparado a partir de los registros auxiliares de contabilidad de IBERDROLA, habiéndose aplicado la legislación vigente en materia contable y los requisitos de formato electrónico establecidos en el Reglamento Delegado UE 2018/815 de la Comisión Europea con la finalidad de mostrar la imagen fiel del patrimonio, de la situación financiera y de los resultados de IBERDROLA. </span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">El Estado de flujos de efectivo se ha preparado con el fin de informar verazmente sobre el origen y la utilización de los activos monetarios representativos de efectivo y otros activos líquidos equivalentes de IBERDROLA.</span></p><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">El Balance de IBERDROLA a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1716"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1716"></wk:observed-region-end><span class="C-Bodytext"> presenta un </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1731"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="déficit" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">déficit</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1731"></wk:observed-region-end><span class="C-Bodytext"> de capital circulante (el pasivo corriente excede del activo corriente) por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1821"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2656" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2.656</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1821"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, que se encuentra fundamentalmente justificado por la existencia de deudas con empresas del grupo y asociadas a corto plazo por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1981"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1700" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1.700</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_1981"></wk:observed-region-end><span class="C-Bodytext"> millones de euros y deudas con entidades de crédito por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2051"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1221" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1.221</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2051"></wk:observed-region-end><span class="C-Bodytext"> millones de euros. Los administradores de IBERDROLA manifiestan que será cubierto mediante la generación de fondos de los negocios del Grupo IBERDROLA y los dividendos de sus filiales. Asimismo, el Grupo IBERDROLA dispone de créditos concedidos y no dispuestos por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2330"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="15206" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">15.206</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2330"></wk:observed-region-end><span class="C-Bodytext"> millones de euros (Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2357"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="5" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">5</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2357"></wk:observed-region-end><span class="C-Bodytext">).</span></p></div></div><wk:footer><div style="bottom: 19.84pt; height: 70.87pt; left: 85.04pt; position: absolute; width: 439.44pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 439.44pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:64fd503d5ae7450cb8d1946a7397a761/table:c8b7b55d5f71434086cd7e5b3b63b2bb"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:64fd503d5ae7450cb8d1946a7397a761/table:c8b7b55d5f71434086cd7e5b3b63b2bb"></wk:table-end></div></div></div></wk:footer></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:header><div style="height: 85.05pt; left: 56.69pt; position: absolute; top: 18.51pt; width: 510.0400000000001pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 510.0400000000001pt;"><div style="margin-bottom: 0; margin-top: 0; padding-right: 18pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 471pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 240pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 203.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 27.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 41.25pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-c4234790" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_25/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d/tablerange:641afed77d0444e083eab6082ff7d49d_0-0-1-1-826894/textregion:b5f01ce7a62145a3b099fac5eeccee49_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_25/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d/tablerange:641afed77d0444e083eab6082ff7d49d_0-0-1-1-826894/textregion:b5f01ce7a62145a3b099fac5eeccee49_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">11</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:b483030dc023478085eb76e3a9ea6f4b/table:641afed77d0444e083eab6082ff7d49d"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-2-eed8f987" style="font-size: 14pt; margin-top: 0;"><span id="ib35c2299f07d4389ab3ba6639789275a"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2362"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="2.3. Comparación de la información" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">2.3. Comparación de la información</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2362"></wk:observed-region-end></p><p class="Bodytext-4abc3c9b" style="font-size: 11pt;"><span class="C-Bodytext">De acuerdo con la legislación mercantil, se presenta, a efectos comparativos, con cada una de las partidas del Balance, de la Cuenta de pérdidas y ganancias, del Estado de cambios en el patrimonio neto y del Estado de flujos de efectivo, además de las cifras del ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2638"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34/frag:1fd217b455274de1abe785fc8646afde/textregion:1fd217b455274de1abe785fc8646afde_2638"></wk:observed-region-end><span class="C-Bodytext">, las correspondientes al ejercicio anterior. En la Memoria también se incluye información cuantitativa del ejercicio anterior.</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_34"></wk:section-end><wk:section-start hidden-section="false" name="3. Distribución de resultados" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_37102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 17pt;"><span id="iac6e406f02684273a91ae3fd8cdb06a1"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37/frag:810878999ee74b4795cdb0572ada40fa/textregion:810878999ee74b4795cdb0572ada40fa_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="3. Distribución de resultados" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">3. Distribución de resultados</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37/frag:810878999ee74b4795cdb0572ada40fa/textregion:810878999ee74b4795cdb0572ada40fa_5"></wk:observed-region-end></p><p class="Bodytext-5d5158fd" style="font-size: 11pt;"><span class="C-Bodytext">El Consejo de Administración de IBERDROLA ha acordado proponer a la Junta General de Accionistas la aprobación de la siguiente distribución de los resultados del ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37/frag:810878999ee74b4795cdb0572ada40fa/textregion:810878999ee74b4795cdb0572ada40fa_180"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37/frag:810878999ee74b4795cdb0572ada40fa/textregion:810878999ee74b4795cdb0572ada40fa_180"></wk:observed-region-end><span class="C-Bodytext"> y del remanente de ejercicios anteriores, expresado en millones de euros:</span></p><div style="margin-bottom: 15pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_37/frag:810878999ee74b4795cdb0572ada40fa/table:b20a1aaa80674ace99edbd2a127760b1"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 440.25pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 164.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 276pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-7785677d" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-01