tream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-TableGrid-nivel-1">0</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:52cf77964e314dfda2692dc88f0fa99d/tablerange:52cf77964e314dfda2692dc88f0fa99d_15-4-1-1-826894"></wk:observed-region-end></p></td><td class="cellStyle-3780e2db" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="TableGrid-nivel-1-2a634c4d" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:52cf77964e314dfda2692dc88f0fa99d/tablerange:52cf77964e314dfda2692dc88f0fa99d_15-5-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="284" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-TableGrid-nivel-1">284</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:52cf77964e314dfda2692dc88f0fa99d/tablerange:52cf77964e314dfda2692dc88f0fa99d_15-5-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:52cf77964e314dfda2692dc88f0fa99d"></wk:table-end></div><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Durante los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_30"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_30"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_35"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_35"></wk:observed-region-end><span class="C-Bodytext">, IBERDROLA no ha activado importe alguno de gastos financieros como mayor valor del inmovilizado material.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">En los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_163"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_163"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_168"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_168"></wk:observed-region-end><span class="C-Bodytext">, no se han incluido gastos de personal relacionados directa o indirectamente con el inmovilizado en curso, como mayor coste de dichos activos.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Durante los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_337"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_337"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_342"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_342"></wk:observed-region-end><span class="C-Bodytext"> no se han adquirido ni enajenado elementos de inmovilizado material a empresas del grupo y asociadas. </span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">IBERDROLA no posee elementos de inmovilizado material situados fuera del territorio español en los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_558"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_558"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_563"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_563"></wk:observed-region-end><span class="C-Bodytext">.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_588"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_588"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_593"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_593"></wk:observed-region-end><span class="C-Bodytext"> el importe de las instalaciones materiales y otro inmovilizado material en explotación totalmente amortizados tiene un valor de coste de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_733"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="335" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">335</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_733"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_738"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="332" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">332</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_738"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, respectivamente, de los cuales ningún importe correspondía a construcciones.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_858"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_858"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_863"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_863"></wk:observed-region-end><span class="C-Bodytext"> IBERDROLA no mantiene activos materiales en garantía de préstamos bancarios.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_964"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_964"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_969"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_969"></wk:observed-region-end><span class="C-Bodytext">, el saldo del inmovilizado material recoge </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1015"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="81.92392517" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">82</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1015"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1020"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="82.87137643" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">83</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1020"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, respectivamente, correspondientes al valor neto contable del terreno y del edificio corporativo de IBERDROLA en Madrid que es objeto de un contrato de arrendamiento financiero. El importe por el que se reconoció inicialmente el activo ascendió a </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1288"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="104" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">104</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1288"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, correspondiente al valor actual de los pagos mínimos a realizar en la fecha de reconocimiento inicial.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 85.05pt; position: absolute; width: 439.08pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 439.08pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:64fd503d5ae7450cb8d1946a7397a761/table:c8b7b55d5f71434086cd7e5b3b63b2bb"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; posi