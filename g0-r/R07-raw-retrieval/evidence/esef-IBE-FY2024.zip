9bb49d3d64aba/table:08ede13d2cfa495d81bf4e870035c0e0/tablerange:08ede13d2cfa495d81bf4e870035c0e0_59-6-1-1-826894"></wk:observed-region-end></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/table:08ede13d2cfa495d81bf4e870035c0e0"></wk:table-end></div><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">La información presentada en el cuadro anterior recoge los nocionales brutos de los instrumentos financieros derivados contratados en valor absoluto (sin compensar posiciones activas y pasivas o de compra y venta), por lo tanto, no supone el riesgo asumido por IBERDROLA ya que únicamente reflejan la base sobre la que se realizan los cálculos para la liquidación del derivado.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">El valor nominal de los pasivos financieros objeto de cobertura de tipo de cambio es el siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 12pt; padding-right: -2pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/table:d7981562aa1a442786bf98a4895f510e"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 453pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 244.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 104.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 104.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 12pt;"><td class="cellStyle-bb557e6d" style="padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="2" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_16