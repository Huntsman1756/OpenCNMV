602_0-0-1-1-826894/textregion:654d90793c6440558307571119b02fa8_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">60</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:9dba79bdd91243d1a86de233029106e3/table:332d1039395241999469f45f55f3f602"></wk:table-end></div><p class="Bodytext-3af96eee" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Heading-1" style="font-size: 17pt; margin-top: 0;"><span id="i8d8ed1e3db99400b88882a05a12c782d"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="15. Derivados" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">15. Derivados</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_5"></wk:observed-region-end></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">El detalle de la composición de los saldos a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_72"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_72"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_77"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_77"></wk:observed-region-end><span class="C-Bodytext"> que recogen la valoración de los instrumentos financieros derivados a dichas fechas, expresado en millones de euros, es el siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/table:11a60e57fee149448e2123603866706c"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 445.5pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 127.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 39.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 13.5pt;"><td class="cellStyle-557c0529" style="padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 12pt; overflow: hidden;"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><span