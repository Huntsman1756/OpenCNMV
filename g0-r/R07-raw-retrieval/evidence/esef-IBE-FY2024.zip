><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">1</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:5e0ae79ade7b48f0b04b207a36173b39/tablerange:5e0ae79ade7b48f0b04b207a36173b39_60-4-1-1-826894"></wk:observed-region-end></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256/frag:3bae7fb76ee04b5bab5d57f0a0b5585f/table:5e0ae79ade7b48f0b04b207a36173b39"></wk:table-end></div><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_256"></wk:section-end><wk:section-start hidden-section="false" name="23.2	Operaciones realizadas por IBERDROLA con partes" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_259102" style="position: absolute; top: 0pt;"></div><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><p class="Heading-2" style="font-size: 14pt;"><span id="i77de8ffc67d54fef88befaa5a7fc57be"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_6"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="23.2. Operaciones realizadas por IBERDROLA con partes vinculadas" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">23.2. Operaciones realizadas por IBERDROLA con partes vinculadas</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_6"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Las operaciones que se detallan a continuación son propias del giro o tráfico ordinario y han sido realizadas en condiciones normales de mercado.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Las operaciones más importantes efectuadas durante los ejercicios </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_221"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_221"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_226"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_226"></wk:observed-region-end><span class="C-Bodytext"> han sido las siguientes:</span></p><p class="Normal-green-titles" style="font-size: 12pt;"><span class="C-Normal-green-titles">Transacciones con accionistas significativos (Nota </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_305"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="11" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Normal-green-titles">11</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_305"></wk:observed-region-end><span class="C-Normal-green-titles">)</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">En el ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_325"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_259/frag:6cbe004a42084340b2edf8882821f1b0/textregion:6cbe004a42084340b2edf8882821f1b0_325"></wk:observed-region-end><span class="C-Bodytext"> no existe ningún accionista significativo que cumpla la definición del artículo 529 vicies de la Ley de Sociedades de Capital por no alcanzar el 10% de los derechos de voto o estar representado en el Consejo de Administración.</span></p><p class="Bodytext-ac881e8c" style="font-size: 12pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;">