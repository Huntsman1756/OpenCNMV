url://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_335"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1938270918" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1.938.270.918</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_335"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_338"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">acciones de la Sociedad han optado por recibir el </span><span class="C-Bodytext-e492cc84 C-Bodytext">Dividendo a cuenta</span><span class="C-Bodytext">. Así pues, el importe total bruto del Dividendo a cuenta que se ha distribuido es de </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_338"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_340"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="447741000" scale="6" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">448</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_340"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_343"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">millones de euros. Como consecuencia, dichos accionistas han renunciado de forma expresa a</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_343"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_346"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1938270918" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1.938.270.918</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_346"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_349"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">derechos de asignación gratuita y, por tanto, a las </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_349"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_351"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="33418464.1" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">33.418.464</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_351"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_354"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">nuevas accio</span><span class="C-Bodytext">nes.</span></p><p class="Bodytext-3d612397" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 32.15pt;">Por otra parte, el número definitivo de acciones o</span><span class="C-Bodytext">rdinarias de 0,75 euros de valor nominal unitario emitidas es de </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_354"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_356"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="76310000" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">76.310.000</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_356"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_359"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">, siendo el importe nominal del aumento de capital (en esta ejecución) de </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_359"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_361"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="57.233" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">57</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_361"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_364"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">millones de euros, lo que supone un incremento del</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_364"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_367"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="true" precision="3" prefix="" raw-value="0.01199" scale="-2" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="5" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1,199 %</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_367"></wk:observed-region-end><span class="C-Bodytext">&#xa0; </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_371"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">sobre la cifra de capital social de IBERDROLA previa a </span><span class="C-Bodytext">esta ejecución.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_371"></wk:observed-region-end></p><p class="Bodytext-6f78b516" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 31.59pt;">En consecuencia, el capital social de IBERDROLA tras el aumento de capital asciende </span><span class="C-Bodytext">a </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_460"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="4830420750" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">4.830.420.750</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_460"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_463"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> euros, </span><span class="C-Bodytext">representado p</span><span class="C-Bodytext">or </span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_463"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_465"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="6440561000" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">6.440.561.000</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_465"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_467"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> acciones ordinarias de 0,75 euros de valor nominal cada una, íntegramente suscrit</span><span class="C-Bodytext">as y desembolsadas.</span></p><p class="Bodytext-3d612397" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 32.15pt;">Tras el cumplimiento de todos los requisitos legales (y, en particular, a la verificación de dicho cumplimiento por la Comisión Nacional del Mercado de Valores), las nuevas acciones han quedado admitidas a negociación en las Bolsas de Valores de Madrid, Barcelona, Bilbao y Valencia, a través del Sistema de Interconexión Bursátil (Mercado Continuo), el</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_467"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_876"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext"> </span><span class="C-Bodytext">1 de febrero de 2025.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_876"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_492"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">En este sentido, la contratación ordinaria de las nuevas acciones ha comenzado el</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_492"></wk:observed-region-end><span class="C-Bodytext"> </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_495"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="5 de febrero de 2025" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">5 de febrero de 2025</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_495"></wk:observed-region-end><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_497"><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_497"></wk:observed-region-end></p><p class="Bodytext-f06626cf" style="font-size: 11pt;"><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_877"><wk:stream consumer="false" type="2"></wk:stream></wk:observed-region-start><span class="C-Bodytext-acc173f9 C-Bodytext">Ampliación de capital Avangrid Inc.</span></p><p class="Bodytext" style="font-size: 11pt;"><span class="C-Bodytext">Con fecha 14 de enero de 2025, IBERDROLA, como accionista único, autorizó una ampliación de capital en Avangrid por importe de 1.900 millones de dólares estadounidenses (1.822 millones de euros, aproximadamente). Los fondos de la aportación se obtuvieron a través de Iberdrola Financiación. El desembolso se realizó el 30 de enero de 2025.</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:9f621883fcb54dfc9777214bc28604dd/textregion:9f621883fcb54dfc9777214bc28604dd_877"></wk:observed-region-end></p><p class="Bodytext" style="font-size: 11pt;"><span><br /></span></p><p class="Bodytext" style="font-size: 11pt; margin-bottom: 0;"><span><br /></span></p></div></div><wk:footer><div style="bottom: 35pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.54999999999995pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.54999999999995pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_265/frag:02c1687fc594410ab52fdbfc41627ee4/table:de766cff13f64d0b9b596ffa19f040de"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 292.5pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 146.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="pad