e" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/textregion:d6c1f3b741e44fb69439bb49d3d64aba_366"></wk:observed-region-end><span class="C-Bodytext">, expresado en millones de euros,</span><span class="C-Bodytext"> es el siguiente:</span></p><div style="margin-bottom: 6pt; margin-top: 8pt;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163/frag:d6c1f3b741e44fb69439bb49d3d64aba/table:08ede13d2cfa495d81bf4e870035c0e0"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; vertical-align: text-bottom; width: 446.25pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 170.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 44.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 44.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 44.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 44.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 54.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 44.25pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 26.25pt;"><td class="cellStyle-d9963a49" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><span class="C-Table-Normal-d0b3ba93 C-Table-Normal">sin dato</span></p></td><td class="cellStyle-d9963a49" style="padding-bottom: 0; padding-left: 2.38pt; padding-right: 2.38pt; padding-top: 0;" rowspan="1" colspan="1"><p class="Table-Normal-01828778" style="margin-bottom: 0; margin-top: 0;"><wk:observed-region-start wuri="wurl://docs.v1/doc: