/frag:ff3c46e55483450b8c4e9328ee876a79/table:4b8697d8cd7a44c08378a10fbfc4644d/tablerange:4b8697d8cd7a44c08378a10fbfc4644d_3-1-1-1-826894"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="1" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="61" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="true" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-TableGrid-nivel-1">61</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:4b8697d8cd7a44c08378a10fbfc4644d/tablerange:4b8697d8cd7a44c08378a10fbfc4644d_3-1-1-1-826894"></wk:observed-region-end></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/table:4b8697d8cd7a44c08378a10fbfc4644d"></wk:table-end></div><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">El importe del valor actual de las cuotas se encuentra registrado en los epígrafes “Deudas a largo plazo - Acreedores por arrendamientos financieros” y “Deudas a corto plazo - Acreedores por arrendamientos financieros” del Balance.</span></p><p class="Bodytext-143636d0" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1836"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1836"></wk:observed-region-end><span class="C-Bodytext"> no se mantienen compromisos firmes de adquisición de bienes de inmovilizado material (</span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1925"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="3" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">3</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1925"></wk:observed-region-end><span class="C-Bodytext"> millones de euros a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1967"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100/frag:ff3c46e55483450b8c4e9328ee876a79/textregion:ff3c46e55483450b8c4e9328ee876a79_1967"></wk:observed-region-end><span class="C-Bodytext">).</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_100"></wk:section-end><wk:section-start hidden-section="false" name="9. Categorías y valoración de instrumentos financieros" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_103"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_103102" style="position: absolute; top: 0pt;"></div><p class="Heading-1" style="font-size: 17pt;"><span id="ib95238170c97448a8e32b78fc4e2202a"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_103/frag:d50024fd8a7645e5ada26949b90eb8de/textregion:d50024fd8a7645e5ada26949b90eb8de_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="9. Categorías y valoración de instrumentos financieros" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-1">9. Categorías y valoración de instrumentos financieros</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_103/frag:d50024fd8a7645e5ada26949b90eb8de/textregion:d50024fd8a7645e5ada26949b90eb8de_5"></wk:observed-region-end></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">A 31 diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_103/frag:d50024fd8a7645e5ada26949b90eb8de/textregion:d50024fd8a7645e5ada26949b90eb8de_26"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_103/frag:d50024fd8a7645e5ada26949b90eb8de/textregion:d50024fd8a7645e5ada26949b90eb8de_26"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-sta