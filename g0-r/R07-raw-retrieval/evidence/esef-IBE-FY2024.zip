rue" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Table-Normal-d27ff4c1 C-Table-Normal">6</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/table:571c8e29796747e499679acd9ce6b814/tablerange:571c8e29796747e499679acd9ce6b814_3-7-1-1-826894"></wk:observed-region-end></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/table:571c8e29796747e499679acd9ce6b814"></wk:table-end></div><p class="Bodytext-76c8d55f" style="font-size: 11pt;"><span class="C-Bodytext">Los préstamos existentes a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_443"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_443"></wk:observed-region-end><span class="C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_448"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_448"></wk:observed-region-end><span class="C-Bodytext"> devengan un interés nominal medio ponderado anual del </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_505"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="2" prefix="" raw-value="0.0177" scale="-2" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="5" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1,77</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_505"></wk:observed-region-end><span class="C-Bodytext">% y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_511"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="2" prefix="" raw-value="0.0179" scale="-2" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="5" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1,79</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_511"></wk:observed-region-end><span class="C-Bodytext">%, respectivamente, tras considerar las correspondientes coberturas. </span></p><p class="Bodytext-7fe260c5" style="font-size: 11pt;"><span class="C-Bodytext-76156918 C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_604"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_604"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_609"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_609"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext">, IBERDROLA ha hecho frente a todos los pagos derivados de su deuda financiera ya vencidos, no existiendo, en consecuencia, importe alguno cuyo vencimiento contractual haya tenido lugar con anterioridad a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_835"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_835"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext">. La deuda financiera de IBERDROLA contiene estipulaciones financieras (</span><span class="C-Bodytext-02316bb8 C-Bodytext">covenants</span><span class="C-Bodytext-76156918 C-Bodytext">) habituales en contratos de esta naturaleza.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext-76156918 C-Bodytext">Por lo que se refiere a las cláusulas relacionadas con la calificación crediticia, IBERDROLA tiene concertadas, a 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1097"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1097"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1102"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2023" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">2023</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1102"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext">, con el Banco Europeo de Inversiones (BEI) operaciones financieras, por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1188"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="96" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">96</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1188"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext"> y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1193"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="131" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext-76156918 C-Bodytext">131</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:0c737487e5cc4c56a07fcb4b5bac96f5/textregion:0c737487e5cc4c56a07fcb4b5bac96f5_1193"></wk:observed-region-end><span class="C-Bodytext-76156918 C-Bodytext"> millones de euros, respectivamente, que podrían requerir su renegociación en supuestos de bajada significativa de </span><span class="C-Bodytext-02316bb8 C-Bodytext">rating</span><span class="C-Bodytext-76156918 C-Bodytext">, previsiblemente equiparando su precio al de otras operaciones con el BEI que no incorporan dichas cláusulas. Adicionalmente, estas operaciones, junto con el </span><span class="C-Bodytext">préstamo sindicado existente de 127 millones de euros</span><span class="C-Bodytext-76156918 C-Bodytext">, son susceptibles de ser declaradas vencidas anticipadamente o de requerir garantías adicionales en caso de cambio de control, salvo que el cambio de control no se considere perjudicial por parte del BEI o del prestamista correspondiente. </span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext-76156918 C-Bodytext">A fecha de formulación de estas Cuentas anuales IBERDROLA no se encuentra en situación de incumplimiento de sus obligaciones financieras o de cualquier tipo de obligación que pudiera dar lugar a una situación de vencimiento anticipado de sus compromisos financieros. IBERDROLA considera que la existencia de las cláusulas citadas no modificará la clasificación de la deuda entre largo y corto plazo que recoge el Balance.</span></p></div></div><wk:footer><div style="bottom: 27.78pt; height: 70.87pt; left: 77.95pt; position: absolute; width: 474.88pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 474.88pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438.75pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 309.75pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 129pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160/frag:ca33e0a901a54e42a2c8f315592d08ec/table:4bbeb99c70c146a2ae9cd28cd00baf35"></wk:table-end></div></div></div></wk:footer><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_160"></wk:section-end><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_157"></wk:section-end></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:section-start hidden-section="false" name="15.	Derivados" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_163"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_163102" style="position: absolute; top: 0pt;"></div><wk:header><div style="height: 85.05pt; left: 63.77pt; position: absolute; top: 18.51pt; width: 488.43pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 488.43pt;"><div style="margin-bottom: 8pt; margin-top: 0; padding-right: 18pt;"><wk: