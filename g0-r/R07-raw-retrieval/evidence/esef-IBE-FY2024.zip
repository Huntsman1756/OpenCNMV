: absolute; top: 32.19pt; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 462pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 246pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 30.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73/tablerange:2dd49fb5e79b447fbbe6ad1f14a43e73_0-0-1-1-826894/textregion:2204661075e84f36bc1f70bbb2bdd553_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Header">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73/tablerange:2dd49fb5e79b447fbbe6ad1f14a43e73_0-0-1-1-826894/textregion:2204661075e84f36bc1f70bbb2bdd553_29"></wk:observed-region-end></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-Text" style="margin-bottom: 0; margin-top: 0;"><span class="C-Header-Text">Iberdrola, S.A.</span></p></td><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-page-number" style="font-size: 8.5pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header-page-number">| </span><span class="C-Header-page-number">47</span></p></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73"></wk:table-end></div></div></div></wk:header><div><div style="display: inline-block; margin-bottom: 0; margin-top: 0; vertical-align: top; width: 100%;"><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-top: 0;"><span class="C-Bodytext-7d780659 C-Bodytext">Facultades delegadas por la Junta General de Accionistas</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">La Junta General de Accionistas celebrada el 2 de abril de </span><span class="C-Bodytext">2020</span><span class="C-Bodytext"> acordó, dentro de los puntos veintidós y veintitrés del orden del día, delegar a favor del Consejo de Administración, con expresa facultad de sustitución, por el plazo de cinco años la facultad para:</span></p><p class="Bodytext-6ef513db" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 14.15pt;">aumentar el capital social en los términos y con los límites recogidos en el artículo 297.1.b) de la Ley de Sociedades de Capital, con la facultad de excluir el derecho de preferencia limitada, y</span></p><p class="Bodytext-a00eb614" style="font-size: 11pt;"><span class="C-Bodytext-f9cba730 C-Bodytext">•</span><span class="C-Bodytext" style="padding-left: 14.15pt;">emitir obligaciones y bonos canjeables por acciones de la Sociedad o de cualquier otra sociedad y/o convertibles en acciones de la Sociedad, así como warrants (opciones para suscribir acciones nuevas de la Sociedad o para adquirir acciones de la Sociedad o de cualquier otra sociedad ya en circulación), con el límite máximo de 5.000 millones de euros. La autorización comprende la delegación de facultades para, en su caso: (i) determinar las bases y modalidades de la conversión, canje o ejercicio; (ii) aumentar capital en la cuantía necesaria para atender las solicitudes de conversión; y (iii) excluir el derecho de preferencia limitada en las emisiones.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">Ambas facultades quedan limitadas, en conjunto, a un importe nominal máximo del 20% del capital social.</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_127"></wk:section-end><wk:section-start hidden-section="false" name="11.2 Prima de emisión " wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_130102" style="position: absolute; top: 0pt;"></div><p class="Heading-2" style="font-size: 14pt;"><span id="ib4008954cc734b27892f4e0d43cc8007"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="11.2. Prima de emisión" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">11.2. Prima de emisión</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_5"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">A 31 de diciembre de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_29"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_29"></wk:observed-region-end><span class="C-Bodytext"> el importe de la prima de emisión asciende a </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_77"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="13777" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">13.777</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130/frag:49fcf4d04f61493996280faa960065e4/textregion:49fcf4d04f61493996280faa960065e4_77"></wk:observed-region-end><span class="C-Bodytext"> millones de euros. El Texto Refundido de la Ley de Sociedades de Capital permite expresamente la utilización del saldo de la prima de emisión para la ampliación de capital y no establece restricción específica alguna en cuanto a la disponibilidad de dicho saldo.</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_130"></wk:section-end><wk:section-start hidden-section="false" name="11.3 Reserva legal" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_133102" style="position: absolute; top: 0pt;"></div><p class="Heading-2" style="font-size: 14pt;"><span id="ie0e31e15811e40efb92c9c95c7b97053"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133/frag:900090e928c24f63b850f7d96b96a73a/textregion:900090e928c24f63b850f7d96b96a73a_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="11.3. Reserva legal" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">11.3. Reserva legal</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133/frag:900090e928c24f63b850f7d96b96a73a/textregion:900090e928c24f63b850f7d96b96a73a_5"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">De acuerdo con el Texto Refundido de la Ley de Sociedades de Capital, debe destinarse una cifra igual al 10% del beneficio del ejercicio a la reserva legal hasta que ésta alcance, al menos, el 20% del capital social.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt;"><span class="C-Bodytext">La reserva legal, por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133/frag:900090e928c24f63b850f7d96b96a73a/textregion:900090e928c24f63b850f7d96b96a73a_258"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="968.999" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">969</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133/frag:900090e928c24f63b850f7d96b96a73a/textregion:900090e928c24f63b850f7d96b96a73a_258"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, podrá utilizarse para aumentar el capital en la parte de su saldo que exceda del 10% del capital ya aumentado. Salvo para la finalidad mencionada anteriormente y mientras no supere el 20% del capital social, esta reserva sólo podrá destinarse a la compensación de pérdidas y siempre que no existan otras reservas disponibles suficientes para este fin.</span></p><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_133"></wk:section-end><wk:section-start hidden-section="false" name="11.4 Reserva por capital amortizado" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_136102" style="position: absolute; top: 0pt;"></div><p class="Heading-2" style="font-size: 14pt;"><span id="if88127f61f974f23a985b05c782fac41"></span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_5"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="11.4. Reserva por capital amortizado" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="0" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Heading-2">11.4. Reserva por capital amortizado</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_5"></wk:observed-region-end></p><p class="Bodytext-c211ff9a" style="font-size: 11pt;"><span class="C-Bodytext">En el ejercicio </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_24"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_24"></wk:observed-region-end><span class="C-Bodytext"> se ha efectuado una reducción de capital por amortización de acciones propias con disminución de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_124"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="137" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">137</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_124"></wk:observed-region-end><span class="C-Bodytext"> millones de euros de capital social y </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_165"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="2072" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">2.072</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_165"></wk:observed-region-end><span class="C-Bodytext"> millones de euros de remanente, en ejecución del acuerdo de la Junta General de Accionistas de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_263"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="2" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" prefix="" raw-value="17 de mayo de 2024" scale="0" show-positive-sign="false" show-thousands-separator="false" suffix="" symbol-placement="6" thousands-separator="." type="6" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="false"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">17 de mayo de 2024</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_263"></wk:observed-region-end><span class="C-Bodytext">.</span></p><p class="Bodytext-07d736ca" style="font-size: 11pt; margin-bottom: 0;"><span class="C-Bodytext">De acuerdo con lo establecido en el artículo 335.c del texto refundido de la Ley de Sociedades de Capital, IBERDROLA mantiene constituida una “Reserva por capital amortizado”, con el carácter de indisponible, por importe de </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_491"><wk:value-format currency-symbol="" decimal-separator="," delimiter-symbol="0" display-zero-as-type="0" format-string="" numbers-as-words="false" percent-symbol-visible="false" precision="0" prefix="" raw-value="1782.476" scale="0" show-positive-sign="false" show-thousands-separator="true" suffix="" symbol-placement="6" thousands-separator="." type="4" unit-format="0" unit-format-suffix="" use-absolute-value="false" use-dashes-for-zero="false" use-parens-for-negatives="true"></wk:value-format><wk:stream consumer="true" type="4"></wk:stream></wk:observed-region-start><span class="C-Bodytext">1.782</span><wk:observed-region-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:67f13f05569d41c797530e813221b5a4/textregion:67f13f05569d41c797530e813221b5a4_491"></wk:observed-region-end><span class="C-Bodytext"> millones de euros, equivalente al nominal del capital social reducido. </span></p></div></div><wk:footer><div style="bottom: 19.84pt; height: 70.87pt; left: 70.87pt; position: absolute; width: 453.26pt;"><div style="bottom: 0; margin-bottom: 0; margin-top: 0; position: absolute; width: 453.26pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:d46f8af84d1747b78dd847ffde2bf49d/table:3a0964ad377749c5a7c8c21adb49a251"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 438pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 219pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 24.75pt;"><td class="cellStyle-752ffde2" rowspan="1" colspan="1"></td><td class="cellStyle-21e3bbc6" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><div style="height: 24.75pt; overflow: hidden;"><p class="Table-Normal-3d41da26" style="font-size: 10pt; margin-bottom: 0; margin-top: 0; position: relative; top: -2.4pt;"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height: 24.56pt; position: relative; top: -0.40499999999999936pt; width: 70.87pt;"></span></p></div></td></tr></tbody></table><wk:table-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136/frag:d46f8af84d1747b78dd847ffde2bf49d/table:3a0964ad377749c5a7c8c21adb49a251"></wk:table-end></div></div></div></wk:footer><wk:section-end wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_136"></wk:section-end></div><wk:page-break></wk:page-break><div class="pageView" style="min-height: 686pt; padding: 85pt 70pt 70pt 70pt; width: 453pt;"><wk:section-start hidden-section="false" name="11.5 Acciones propias" wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139"></wk:section-start><div id="ib50e90b48ff148f8a7f19466ba68bda9_139102" style="position: absolute; top: 0pt;"></div><wk:header><div style="height: 85.05pt; left: 63.78pt; position: absolute; top: 32.19pt; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0; position: absolute; top: 0; width: 502.87pt;"><div style="margin-bottom: 0; margin-top: 0;"><wk:table-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466ba68bda9_139/frag:b2d2b934f1e84cd5a8134d3138dffe4f/table:2dd49fb5e79b447fbbe6ad1f14a43e73"></wk:table-start><table class="tableStyle-9810ea48" style="display: inline-table; margin-bottom: 2pt; margin-top: 2pt; vertical-align: text-bottom; width: 462pt;"><tbody><tr style="height: 0;"><td style="padding: 0; width: 185.25pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 246pt;" rowspan="1" colspan="1"></td><td style="padding: 0; width: 30.75pt;" rowspan="1" colspan="1"></td></tr><tr style="height: 14.25pt;"><td class="cellStyle-ca0da46e" style="padding-bottom: 0; padding-top: 0;" rowspan="1" colspan="1"><p class="Header-326307ad" style="font-size: 10pt; margin-bottom: 0; margin-top: 0;"><span class="C-Header">Informe financiero anual </span><wk:observed-region-start wuri="wurl://docs.v1/doc:b50e90b48ff148f8a7f19466ba68bda9/sec:b50e90b48ff148f8a7f19466b