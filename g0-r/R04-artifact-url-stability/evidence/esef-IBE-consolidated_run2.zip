 charStyle-8bd84864 ps1055">999<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps7262 ss828"><div><div class="ps64 ss73"><span class="f charStyle-8bd84864 ps985">2.747<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps7263 ss828"><div><div class="ps64 ss73"><span class="f charStyle-8bd84864 ps985">1.152<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps7264 ss827"><div><div class="ps64 ss81"><span class="f charStyle-8bd84864 ps995">5.130<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps7265 ss827"><div><div class="ps64 ss81"><span class="f charStyle-8bd84864 ps7240">11.347<span class="f ps4"> </span></span></div></div></div></td></tr></tbody></table></div></div></div><div class="ps7269 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">Como se indica en la Nota </span><span class="f charStyle-ea3d506d ps7267">5</span><span class="f charStyle-ea3d506d ps7268">, los saldos en moneda extranjera distinta del euro son objeto de <span class="f ps4"> </span></span></div><div class="ps7270 ss0"><span class="f charStyle-ea3d506d ps26">cobertura por el riesgo de tipo de cambio.</span></div><div class="ps6147 ss0"><span class="f charStyle-ea3d506d ps26">El desglose por vencimientos de los compromisos futuros de pago de los intereses no </span></div><div class="ps6148 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">devengados a 31 de diciembre de </span><span class="f charStyle-ea3d506d ps7271">2025</span><span class="f charStyle-ea3d506d ps7272"> y </span><span class="f charStyle-ea3d506d ps7273">2024</span><span class="f charStyle-ea3d506d ps7274">,</span><span class="f charStyle-ea3d506d ps7275"> una vez considerado el efecto de las </span></div><div class="ps6149 ss0"><span class="f charStyle-ea3d506d ps26">coberturas de tipo de cambio y tipo de interés y considerando que los tipos de interés y los </span></div><div class="ps7276 ss0"><span class="f charStyle-ea3d506d ps26">tipos de cambio vigentes permanecen constantes hasta vencimiento, expresado en millones </span></div><div class="ps7277 ss0"><span class="f charStyle-ea3d506d ps26">de euros, es el siguiente:</span></div><div class="ps7314 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:95.25pt"></td><td style="padding:0;width:51.75pt"></td><td style="padding:0;width:49.5pt"></td><td style="padding:0;width:49.5pt"></td><td style="padding:0;width:49.5pt"></td><td style="padding:0;width:49.5pt"></td><td style="padding:0;width:54.75pt"></td><td style="padding:0;width:53.25pt"></td></tr><tr style="height:26.25pt"><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps1 ss637"><div><div class="ps332 ss633"><span class="f charStyle-9c0f18c6 ps7278">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps7280 ss435"><div><div class="ps332 ss205"><span cl