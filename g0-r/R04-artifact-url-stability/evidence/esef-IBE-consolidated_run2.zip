lid #000;padding:0"><div class="ps3561 ss314"><div><div class="ps462 ss79"><span class="f charStyle-024643f9 ps3188">Holding<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3563 ss47"><div><div class="ps462 ss46"><span class="f charStyle-024643f9 ps3562">3,50 %</span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3564 ss315"><div><div class="ps462 ss256"><span class="f charStyle-024643f9 ps3291">138<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3565 ss126"><div><div class="ps462 ss75"><span class="f charStyle-adc62489 ps3356">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3566 ss126"><div><div class="ps462 ss75"><span class="f charStyle-adc62489 ps3356">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3567 ss316"><div><div class="ps462 ss64"><span class="f charStyle-adc62489 ps858">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3568 ss316"><div><div class="ps462 ss64"><span class="f charStyle-024643f9 ps870">5<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:12pt"><td style="bord