id #000;border-top:0.5pt solid #000;padding:0"><div class="ps5072 ss89"><div><div class="ps298 ss75"><span class="f charStyle-024643f9 ps3209">0<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5073 ss89"><div><div class="ps298 ss75"><span class="f charStyle-024643f9 ps3209">0<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5074 ss237"><div><div class="ps298 ss234"><span class="f charStyle-024643f9 ps3094">0<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5075 ss89"><div><div class="ps298 ss75"><span class="f charStyle-024643f9 ps3209">3<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps2438 ss556"><div><div class="ps298 ss552"><span class="f charStyle-8bd84864 ps657">Total<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5076 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">2<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5077 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">1<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps2608 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">0<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5078 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">0<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5079 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">0<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5080 ss237"><div><div class="ps298 ss234"><span class="f charStyle-8bd84864 ps3094">0<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps5081 ss89"><div><div class="ps298 ss75"><span class="f charStyle-8bd84864 ps3209">3<span class="f ps4"> </span></span></div></div></div></td></tr></tbody></table></div></div></div><div class="ps5083 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">Los préstamos existentes a 31 de diciembre de </span><span class="f charStyle-ea3d506d ps3689">2025</span><span class="f charStyle-ea3d506d ps3690"> y </span><span class="f charStyle-ea3d506d ps3691">2024</span><span class="f charStyle-ea3d506d ps3692"> devengan un interés nominal </span></div><div class="ps5087 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">medio ponderado anual del </span><span class="f charStyle-ea3d506d ps4024">1,49</span><span class="f charStyle-ea3d506d ps5084">% y </span><span class="f charStyle-ea3d506d ps5085">1,77</span><span class="f charStyle-ea3d506d ps5086">%, respectivamente, tras considerar las </span></div><div class="ps5088 ss22"><span class="f charStyle-ea3d506d ps26">correspondientes coberturas. </span></div><div class="ps5089 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">A 31 de diciembre de </span><span class="f charStyle-ea3d506d ps2254">2025</span><span class="f charStyle-ea3d506d ps2255"> y </span><span class="f charStyle-ea3d506d ps2256">2024</span><span class="f charStyle-ea3d506d ps2257">, IBERDROLA ha hecho frente a todos los pagos </span></div><div class="ps5090 ss22"><span class="f charStyle-ea3d506d ps26">derivados de su deuda financiera ya vencidos, no existiendo, en consecuencia, importe </span></div><div class="ps5091 ss22"><span class="f charStyle-ea3d506d ps26">alguno cuyo vencimiento contractual haya tenido lugar con anterioridad a 31 de diciembre de </span></div><div class="ps5094 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">2025</span><span class="f charStyle-ea3d506d ps648">. La deuda financiera de IBERDROLA contiene estipulaciones financieras (</span><span class="f charStyle-6006e977 ps5092">covenants</span><span class="f charStyle-ea3d506d ps5093">) </span></div><div class="ps5095 ss22"><span class="f charStyle-ea3d506d ps26">habituales en contratos de esta naturaleza.</span></div><div class="ps5096 ss22"><span class="f charStyle-ea3d506d ps26">Por lo que se refiere a las cláusulas relacionadas con la calificación crediticia, IBERDROLA </span></div><div class="ps5100 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">tiene concertadas, a 31 de diciembre de </span><span class="f charStyle-ea3d506d ps5097">2025</span><span class="f charStyle-ea3d506d ps3138"> y </span><span class="f charStyle-ea3d506d ps5098">2024</span><span class="f charStyle-ea3d506d ps5099">, con el Banco Europeo de Inversiones </span></div><div class="ps5106 ss22" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">(BEI) operaciones financieras, por importe de </span><span class="f charStyle-ea3d506d ps5101">53</span><span class="f charStyle-ea3d506d ps5102"> y </span><span class="f charStyle-ea3d506d ps5103">96</span><span class="f charStyle-ea3d506d ps5104"> </span><span class="f charStyle-69df70f1 ps5105"><span style="background-color:inherit">millones de euros, respectivamente, </span><span class="f ps4"> </span></span></div><div class="ps5108 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">que podrían requerir su renegociación en supuestos de bajada significativa de </span></span><span class="f charStyle-e9db43c8 ps5107"><span style="background-color:inherit">rating</span></span><span class="f charStyle-69df70f1 ps645"><span style="background-color:inherit">, </span></span></div><div class="ps5109 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">previsiblemente equiparando su precio al de otras operaciones con el BEI que no incorporan </span></span></div><div class="ps5111 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">dichas cláusulas. Adicionalmente, estas operaciones, junto con el </span></span><span class="f charStyle-ea3d506d ps5110">préstamo sindicado </span></div><div class="ps5113 ss22"><span class="f charStyle-ea3d506d ps26">existente de 127 millones de euros</span><span class="f charStyle-69df70f1 ps5112"><span style="background-color:inherit">, son susceptibles de ser declaradas vencidas </span></span></div><div class="ps5114 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">anticipadamente o de requerir garantías adicionales en caso de cambio de control, salvo que </span></span></div><div class="ps5115 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">el cambio de control no se considere perjudicial por parte del BEI o del prestamista </span></span></div><div class="ps5116 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">correspondiente. </span></span></div><div class="ps5117 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">A fecha de formulación de estas Cuentas anuales IBERDROLA no se encuentra en situación </span></span></div><div class="ps5118 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">de incumplimiento de sus obligaciones financieras o de cualquier tipo de obligación que </span></span></div><div class="ps5119 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">pudiera dar lugar a una situación de vencimiento anticipado de sus compromisos financieros. </span></span></div><div class="ps5120 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">IBERDROLA considera que la existencia de las cláusulas citadas no modificará la </span></span></div><div class="ps5121 ss22"><span class="f charStyle-69df70f1 ps26"><span style="background-color:inherit">clasificación de la deuda entre largo y corto plazo que recoge el Balance.</span></span></div></div></div><div class="pageView" style="--justify:justify;height:842pt;width:595pt"><div class="ps43 fo"><div style="width:453pt"><div class="ps5128 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:329.25pt"></td><td style="padding:0;width:123.75pt"></td></tr><tr style="height:24.75pt"><td style="border-top:1pt solid #00a443;padding:0"></td><td style="border-top:1pt solid #00a443;padding:0"><div class="ps5127 ss565"><div><div class="ps47 ss564"><div class="ps5126"><div class="ps1"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height:24.56pt;width:70.87pt"></span></div></div></div></div></div></td></tr></tbody></table></div></div></div></div></div><div class="ps1 fo"><div style="width:470pt"><div class="ps42 ss0"><div class="ss477 ws0 ps5124"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:192.75pt"></td><td style="padding:0;width:227.25pt"></td><td style="padding:0;width:32.25pt"></td></tr><tr style="height:39.75pt"><td style="padding:0"><div class="ps1 ss559"><div><div class="ps36 ss558" style="font-size:12pt"><span class="f charStyle-9c0f18c6 ps51">Informe financiero anual </span><span class="f charStyle-9c0f18c6 ps1223">2025</span></div></div></div></td><td style="padding:0"><div class="ps3412 ss561"><div><div class="ps36 ss560"><span class="f charStyle-be0079b2 ps5122">Iberdrola, S.A.<span class="f ps4"> </span></span></div></div></div></td><td style="padding:0"><div class="ps3406 ss563"><div><div class="ps4956 ss562"><span class="f charStyle-96cb1c74 ps5123">| 57</span></div></div></div></td></tr></tbody></table></div></div></div></div></div><div><div id="id9a6c717e18948d0a392eab1a21cd936_160102" style="position:absolute;top:85.05pt"></div><div class="ps458 ss0" style="font-size:12pt"><span class="f charStyle-78791bf4 ps26">15. Derivados<span id="i6b21997090d44de3826f3b3a42c20984"></span></span></div><div class="ps2180 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">El detalle de la composición de los saldos a 31 de diciembre de </span><span class="f charStyle-ea3d506d ps5129">2025</span><span class="f charStyle-ea3d506d ps4025"> y </span><span