00000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2791 ss191"><div><div class="ps298 ss188"><span class="f charStyle-024643f9 ps657">2028<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2792 ss142"><div><div class="ps298 ss141"><span class="f charStyle-024643f9 ps2787">4<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps1271 ss191"><div><div class="ps298 ss188"><span class="f charStyle-024643f9 ps657">2029<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2793 ss142"><div><div class="ps298 ss141"><span class="f charStyle-024643f9 ps2787">4<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2794 ss191"><div><div class="ps298 ss188"><span class="f charStyle-024643f9 ps657">2030<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2795 ss142"><div><div class="ps298 ss141"><span class="f charStyle-024643f9 ps2787">4<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2796 ss191"><div><div class="ps298 ss188"><span class="f charStyle-024643f9 ps657">De 2031 en adelante<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2798 ss142"><div><div class="ps298 ss141"><span class="f charStyle-024643f9 ps2797">37<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2799 ss191"><div><div class="ps298 ss188"><span class="f charStyle-8bd84864 ps51">Total<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps2801 ss142"><div><div class="ps298 ss141"><span class="f charStyle-8bd84864 ps2800">57<span class="f ps4"> </span></span></div></div></div></td></tr></tbody></table></div></div></div><div class="ps2803 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:372.75pt"></td><td style="padding:0;width:80.25pt"></td></tr><tr style="height:13.5pt"><td style="background-color:#007f33;border-bottom:0.5pt solid #000000;border-left:0.5pt solid #000000;border-right:0.5pt solid #000000;border-top:0.5pt solid #000000;padding:0"><div class="ps1 ss189"><div><div class="ps64 ss188"><span class="f charStyle-9c0f18c6 ps2784">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000000;border-left:0