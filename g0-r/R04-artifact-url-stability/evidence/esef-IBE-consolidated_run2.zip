ss256"><span class="f charStyle-024643f9 ps3370">11<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3576 ss319"><div><div class="ps674 ss75"><span class="f charStyle-adc62489 ps3356">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3577 ss319"><div><div class="ps674 ss75"><span class="f charStyle-adc62489 ps3356">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3578 ss324"><div><div class="ps674 ss64"><span class="f charStyle-adc62489 ps858">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3579 ss324"><div><div class="ps674 ss64"><span class="f charStyle-024643f9 ps870">0<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3580 ss293"><div><div class="ps298 ss284"><span class="f charStyle-8bd84864 ps51">Total<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3581 ss261"><div><div class="ps298 ss250"><span class="f charStyle-7329c94f ps3376">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3582 ss89"><div><div class="ps298 ss75"><span class="f charStyle-7329c94f ps3378">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3583 ss92"><div><div class="ps298 ss81"><span class="f charStyle-7329c94f ps3380">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3584 ss91"><div><div class="ps298 ss79"><span class="f charStyle-7329c94f ps3382">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3585 ss262"><div><div class="ps298 ss46"><span class="f charStyle-7329c94f ps3384">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3586 ss263"><div><div class="ps298 ss256"><span class="f charStyle-8bd84864 ps3386">49.378<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3587 ss89"><div><div class="ps298 ss75"><span class="f charStyle-7329c94f ps3378">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3588 ss89"><div><div class="ps298 ss75"><span class="f charStyle-7329c94f ps3378">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3589 ss65"><div><div class="ps298 ss64"><span class="f charStyle-7329c94f ps2433">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#fff5ec;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3590 ss65"><div><div class="ps298 ss64"><span class="f charStyle-8bd84864 ps909">6.302<span class="f ps4"> </span></span></div></div></div></td></tr></tbody></table></div></div></div><div class="ps3597 ss247" style="font-size:12pt"><span class="f charStyle-375804c7 ps3591"><sup>(1)</sup></span><span class="f charStyle-02e55fcf ps3592">&#xa0; Sociedades cabeceras de grupo. La información referente a Capital, Reservas y Resultados de los ejercicios </span><span class="f charStyle-02e55fcf ps3593">2025</span><span class="f charStyle-02e55fcf ps3594"> y </span><span class="f charStyle-02e55fcf ps3595">2024</span><span class="f charStyle-02e55fcf ps3596"> se presenta a nivel consolidado de acuerdo con </span></div><div class="ps3599 ss247"><span class="f charStyle-02e55fcf ps3598">las Normas de Formulación de Cuentas Anuales Consolidadas.</span></div><div class="ps3605 ss247" style="font-size:12pt"><span class="f charStyle-375804c7 ps3591"><sup>(2)&#xa0; </sup></span><span class="f charStyle-02e55fcf ps3600">Sociedades cabeceras de grupo. La información referente a Capital, Reservas y Resultados de los ejercicios </span><span class="f charStyle-02e55fcf ps3601">2025</span><span class="f charStyle-02e55fcf ps3602"> y </span><span class="f charStyle-02e55fcf ps3603">2024</span><span class="f charStyle-02e55fcf ps3604"> se presenta a nivel consolidado de acuerdo con </span></div><div class="ps3606 ss247"><span class="f charStyle-02e55fcf ps3598">las Normas Internacionales de Información Financiera según han sido aprobadas por la Unión Europea. Los importes no difieren significativamente de los que se hubieran </span></div><div class="ps3607 ss247"><span class="f charStyle-02e55fcf ps3598">obtenido aplicando la normativa contable española.</span></div><div class="ps3612 ss247" style="font-size:12pt"><span class="f charStyle-375804c7 ps3591"><sup>(3)&#xa0; </sup></span><span class="f charStyle-02e55fcf ps3600">La información de Neoenergia, S.A. referente a Capital, Reservas y Resultados de los ejercicios </span><span class="f charStyle-02e55fcf ps3608">2025</span><span class="f charStyle-02e55fcf ps3609"> y </span><span class="f charStyle-02e55fcf ps3610">2024</span><span class="f charStyle-02e55fcf ps3611"> se presenta en Iberdrola Energía, S.A.U.</span></div></div></div><div class="pageView" style="--justify:justify;height:842pt;width:595pt"><div class="ps43 fo"><div style="width:453pt"><div class="ps49 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:234pt"></td><td style="padding:0;width:219pt"></td></tr><tr style="height:24.75pt"><td style="border-top:1pt solid #00a443;padding:0"></td><td style="border-top:1pt solid #00a443;padding:0"><div class="ps3649 ss333"><div><div class="ps47 ss332"><div class="ps3648"><div class="ps1"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height:24.56pt;width:70.87pt"></span></div></div></div></div></div></td></tr></tbody></table></div></div></div></div></div><div class="ps1 fo"><div style="width:453pt"><div class="ps42 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:185.25pt"></td><td style="padding:0;width:234.75pt"></td><td style="padding:0;width:33pt"></td></tr><tr style="height:41.25pt"><td style="padding:0"><div class="ps1 ss327"><div><div class="ps1224 ss326" style="font-size:12pt"><span class="f charStyle-9c0f18c6 ps51">Informe financiero anual </span><span class="f charStyle-9c0f18c6 ps1223">2025</span></div></div></div></td><td style="padding:0"><div class="ps2597 ss329"><div><div class="ps1224 ss328"><span class="f charStyle-be0079b2 ps3646">Iberdrola, S.A.<span class="f ps4"> </span></span></div></div></div></td><td style="padding:0"><div class="ps3406 ss331"><div><div class="ps1228 ss330"><span class="f charStyle-96cb1c74 ps3647">| 39</span></div></div></div></td></tr></tbody></table></div></div></div></div></div><div><div id="id9a6c717e18948d0a392eab1a21cd936_115102" style="position:absolute;top:85.05pt"></div><div class="ps3616 ss0" style="font-size:12pt"><span class="f charStyle-db032324 ps26">Operaciones más significativas de los ejercicios </span><span class="f charStyle-db032324 ps3613">2025</span><span class="f charStyle-db032324 ps3614"> y </span><span class="f charStyle-db032324 ps3615">2024</span></div><div class="ps3621 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">Las operaciones más significativas producidas en los ejercicios </span><span class="f charStyle-ea3d506d ps3617">2025</span><span class="f charStyle-ea3d506d ps3618"> y </span><span class="f charStyle-ea3d506d ps3619">2024</span><span class="f charStyle-ea3d506d ps3620"> con respecto a </span></div><div class="ps3622 ss0"><span class="f charStyle-ea3d506d ps26">las participaciones propiedad de IBERDROLA han sido las siguientes:</span></div><div class="ps2580 ss0"><span class="f charStyle-b9b1b892 ps26">Ejercicio 2025</span></div><div class="ps3623 ss0"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">En diciembre de 2025, IBERDROLA ha realizado aportaciones por importe de 1.900 </span></div><div class="ps2588 ss0"><span class="f charStyle-ea3d506d ps1476">y 270 millones de euros a sus filiales Iberdrola Energía, S.A.U. e Iberdrola Energía </span></div><div class="ps3624 ss0"><span class="f charStyle-ea3d506d ps1476">Internacional, S.A.U., respectivamente.</span></div><div class="ps3625 ss0"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">Con fecha 14 de enero de 2025, IBERDROLA, como accionista único, ha autorizado </span></div><div class="ps1935 ss0"><span class="f charStyle-ea3d506d ps1476">una ampliación de capital en Avangrid por importe de 1.900 millones de dólares </span></div><div class="ps3626 ss0"><span class="f charStyle-ea3d506d ps1476">estadounidenses (1.822 millones de euros, aproximadamente). Los fondos de la </span></div><div class="ps3627 ss0"><span class="f charStyle-ea3d506d ps1476">aportación se han obtenido a través de Iberdrola Financiación, S.A.U. El desembolso </span></div><div class="ps1908 ss0"><span class="f charStyle-ea3d506d ps1476">se ha realizado el 30 de enero de 2025.</span></div><div class="ps1755 ss0"><span class="f charStyle-b9b1b892 ps26">Ejercicio 2024</span></div><div class="ps3628 ss0"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">En marzo de 2024, IBERDROLA presentó al Consejo de Administración de Avangrid, </span></div><div class="ps3629 ss0"><span class="f charStyle-ea3d506d ps1476">Inc. (AVANGRID) una indicación de interés preliminar no vinculante proponiendo la </span></div><div class="ps3630 ss0"><span class="f charStyle-ea3d506d ps1476">adquisición, a través de una fusión o de otro modo que se acuerde entre las partes, </span></div><div class="ps3631 ss0"><span class="f charStyle-ea3d506d ps1476">de todas las acciones ordinarias de AVANGRID que no sean ya propiedad de </span></div><div class="ps3632 ss0"><span class="f charStyle-ea3d506d ps1476">IBERDROLA. </span></div><div class="ps1915 ss0"><span class="f charStyle-ea3d506d ps1476">En mayo de 2024, IBERDROLA suscribió un acuerdo de fusión con AVANGRID y con </span></div><div class="ps1916 ss0"><span class="f charStyle-ea3d506d ps1476">la sociedad participada por IBERDROLA Arizona Merger Sub, Inc. (Merger Sub), en </span></div><div class="ps1917 ss0"><span class="f charStyle-ea3d506d ps1476">virtud del cual IBERDROLA adquiriría todas las acciones ordinarias de AVANGRID </span></div><div class="ps3633 ss0"><span class="f charStyle-ea3d506d ps1476">que no fueran ya propiedad de IBERDROLA por un precio de 35,75 dólares </span></div><div class="ps3634 ss0"><span class="f charStyle-ea3d506d ps1476">estadounidenses en efectivo por acción. Una vez consumada la fusión por absorción </span></div><div class="ps3635 ss0"><span class="f charStyle-ea3d506d ps1476">de Merger Sub por parte de AVANGRID, IBERDROLA sería titular del 100% del </span></div><div class="ps3636 ss0"><span class="f charStyle-ea3d506d ps1476">capital social de AVANGRID. <span class="f ps4"> </span></span></div><div class="ps2096 ss0"><span class="f charStyle-ea3d506d ps1476">El 26 de septiembre de 2024 se celebró la Junta General de Accionistas de </span></div><div class="ps2097 ss0"><span class="f charStyle-ea3d506d ps1476">AVANGRID donde se obtuvo el voto favorable al acuerdo de fusión. Previamente, la </span></div><div class="ps2098 ss0"><span class="f charStyle-ea3d506d ps1476">transacción fue aprobada por parte del Consejo de Administración de AVANGRID.</span></div><div class="ps2099 ss0"><span class="f charStyle-ea3d506d ps1476">Una vez recibidas las autorizaciones necesarias, la consumación de la fusión de </span></div><div class="ps2100 ss0"><span class="f charStyle-ea3d506d ps1476">AVANGRID y Merger Sub, deviniendo IBERDROLA titular del 100% del capital social </span></div><div class="ps2101 ss0"><span class="f charStyle-ea3d506d ps1476">de AVANGRID tuvo lugar el 23 de diciembre de 2024.</span></div><div class="ps3637 ss0"><span class="f charStyle-ea3d506d ps1476">La contraprestación agregada a pagar por IBERDROLA a los actuales titulares de </span></div><div class="ps3638 ss0"><span class="f charStyle-ea3d506d ps1476">acciones de AVANGRID distintos de IBERDROLA en virtud de la operación ascendió </span></div><div class="ps3639 ss0"><span class="f charStyle-ea3d506d ps1476">a 2.551 millones de dólares estadounidenses, equivalentes a 2.454 millones de </span></div><div class="ps2105 ss0"><span class="f charStyle-ea3d506d ps1476">euros. Adicionalmente, se incluyeron como mayor inversión los costes asociados a la </span></div><div class="ps2106 ss0"><span class="f charStyle-ea3d506d ps1476">transacción que ascendieron a 18 millones de euros.</span></div><div class="ps3640 ss0"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">En 2024 Iberdrola España, S.A.U. aprobó el reparto de reservas y dividendo a cuenta </span></div><div class="ps3641 ss0"><span class="f charStyle-ea3d506d ps1476">por importe de 7.700 millones de euros, de los cuales 5.666 millones de euros fueron </span></div><div class="ps3642 ss0"><span class="f charStyle-ea3d506d ps1476">registrados con cargo al epígrafe ”Importe neto de la cifra de negocios” y 2.034 </span></div><div class="ps3643 ss0"><span class="f charStyle-ea3d506d ps1476">millones de euros minorando el valor contable de la inversión, al tratarse de una </span></div><div class="ps3644 ss0"><span class="f charStyle-ea3d506d ps1476">recuperación de parte de la inversión.</span></div></div></div><div class="pageView" style="--justify:justify;height:842pt;width:595pt"><div class="ps43 fo"><div style="width:453pt"><div class="ps49 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:234pt"></td><td style="padding:0;width:219pt"></td></tr><tr style="height:24.75pt"><td style="border-top:1pt solid #00a443;padding:0"></td><td style="border-top:1pt solid #00a443;padding:0"><div class="ps3649 ss333"><div><div class="ps47 ss332"><div class="ps3648"><div class="ps1"><span class="image-2ef6a85a7384a6a81ea46165be8e0060d1a812b5b92e6320915b0d070cb41e7e" style="height:24.56pt;width:70.87pt"></span></div></div></div></div></div></td></tr></tbody></table></div></div></div></div></div><div class="ps1 fo"><div style="width:453pt"><div class="ps42 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:185.25pt"></td><td style="padding:0;width:234.75pt"></td><td style="padding:0;width:33pt"></td></tr><tr style="height:41.25pt"><td style="padding:0"><div class="ps1 ss327"><div><div class="ps1224 ss326" style="font-size:12pt"><span class="f charStyle-9c0f18c6 ps51">Informe financiero anual </span><span class="f charStyle-9c0f18c6 ps1223">2025</span></div></div></div></td><td style="padding:0"><div class="ps2597 ss329"><div><div class="ps1224 ss328"><span class="f charStyle-be0079b2 ps3646">Iberdrola, S.A.<span class="f ps4"> </span></span></div></div></div></td><td style="padding:0"><div class="ps3406 ss331"><div><div class="ps1228 ss330"><span class="f charStyle-96cb1c74 ps3647">| 40</span></div></div></div></td></tr></tbody></table></div></div></div></div></div><div><div class="ps3616 ss0"><span class="f charStyle-db032324 ps26">Correcciones valorativas por deterioro</span></div><div class="ps3621 ss0" style="font-size:12pt"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">En </span><span class="f charStyle-ea3d506d ps3650">2025</span><span class="f charStyle-ea3d506d ps3651"> se ha dotado una corrección valorativa de </span><span class="f charStyle-ea3d506d ps3652">3</span><span class="f charStyle-ea3d506d ps3653"> millones de euros por deterioro </span></div><div class="ps3654 ss0"><span class="f charStyle-ea3d506d ps1476">de Iberdrola Participaciones, S.A.U. debido a la diferencia entre su correspondiente </span></div><div class="ps3659 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps1476">valor en libros y el importe recuperable (dotación de </span><span class="f charStyle-ea3d506d ps3655">54</span><span class="f charStyle-ea3d506d ps3656"> millones de euros en </span><span class="f charStyle-ea3d506d ps3657">2024</span><span class="f charStyle-ea3d506d ps3658">).</span></div><div class="ps3660 ss0"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">A 31 de diciembre de 2023 los estados financieros individuales de IBERDROLA </span></div><div class="ps3661 ss0"><span class="f charStyle-ea3d506d ps1476">incluían una corrección valorativa de la inversión mantenida en Iberdrola </span></div><div class="ps3666 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps1476">Financiación, S.A.U. por importe de </span><span class="f charStyle-ea3d506d ps3662">24</span><span class="f charStyle-ea3d506d ps3663"> millones de euros que fue revertida en </span><span class="f charStyle-ea3d506d ps3664">2024</span><span class="f charStyle-ea3d506d ps3665">. </span></div><div class="ps3667 ss0"><span class="f charStyle-ea3d506d ps1476">La corrección valorativa se calculó como diferencia entre el valor en libros de la </span></div><div class="ps3668 ss0"><span class="f charStyle-ea3d506d ps1476">participación y el valor razonable de todos los activos y pasivos que la componen.</span></div><div class="ps3671 ss0" style="font-size:12pt"><span class="f charStyle-c7c814ec ps1475">•<span class="f ps4"> </span></span><span class="f charStyle-ea3d506d ps1476">En el ejercicio </span><span class="f charStyle-9fbf8957 ps3669">2025</span><span class="f charStyle-ea3d506d ps3670"> la Sociedad ha dotado una corrección valorativa por deterioro de </span></div><div class="ps3672 ss0"><span class="f charStyle-ea3d506d ps1476">Scottish Power Overseas Holdings, Ltd. por la diferencia entre su correspondiente </span></div><div class="ps3673 ss0"><span class="f charStyle-ea3d506d ps1476">valor en libros e importe recuperable. El importe de la dotación de la corrección </span></div><div class="ps3677 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps1476">valorativa ha ascendido a </span><span class="f charStyle-ea3d506d ps3674">4</span><span class="f charStyle-ea3d506d ps3675"> millones de euros (</span><span class="f charStyle-ea3d506d ps2554">15</span><span class="f charStyle-ea3d506d ps3676"> millones de euros de reversión en </span></div><div class="ps3679 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps1476">2024</span><span class="f charStyle-ea3d506d ps3678">).</span></div><div id="id9a6c717e18948d0a392eab1a21cd936_118102" style="position:absolute;top:303.4pt"></div><div class="ps3680 ss0"><span class="f charStyle-db032324 ps26">Análisis de deterioro</span></div><div class="ps3681 ss0"><span class="f charStyle-ea3d506d ps26">El resto de participaciones en empresas del grupo y asociadas no presenta indicios de </span></div><div class="ps3682 ss0"><span class="f charStyle-ea3d506d ps26">deterioro a 31 de diciembre de 2025. A 31 de diciembre de 2024 existían indicios de </span></div><div class="ps3683 ss0"><span class="f charStyle-ea3d506d ps26">deterioro de la participación de NEOENERGIA ya que el valor de cotización era inferior al </span></div><div class="ps3684 ss0"><span class="f charStyle-ea3d506d ps26">valor contable de la participación. Tras el análisis realizado sobre la recuperabilidad de la </span></div><div class="ps3685 ss0"><span class="f charStyle-ea3d506d ps26">participación en NEOENERGIA se concluyó que no se consideraba necesario realizar </span></div><div class="ps3686 ss0"><span class="f charStyle-ea3d506d ps26">saneamiento alguno a 31 de diciembre de 2024.</span></div><div id="id9a6c717e18948d0a392eab1a21cd936_121102" style="position:absolute;top:426pt"></div><div class="ps3687 ss0" style="font-size:12pt"><span class="f charStyle-78791bf4 ps26">11. Patrimonio neto<span id="i61b86f17f03a491783114b045b885a54"></span></span></div><div id="id9a6c717e18948d0a392eab1a21cd936_124102" style="position:absolute;top:454.4pt"></div><div class="ps3688 ss0" style="font-size:12pt"><span class="f charStyle-b43a7c41 ps26">11.1. Capital escriturado<span id="i027c6a17c7994a6b9a7d53de7052d618"></span></span></div><div class="ps3693 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">Los movimientos habidos durante los ejercicios </span><span class="f charStyle-ea3d506d ps3689">2025</span><span class="f charStyle-ea3d506d ps3690"> y </span><span class="f charStyle-ea3d506d ps3691">2024</span><span class="f charStyle-ea3d506d ps3692"> en el capital social de </span></div><div class="ps3694 ss0" style="font-size:12pt"><span class="f charStyle-ea3d506d ps26">IBERDROLA han sido los siguientes:</span></div><div class="ps3784 ss0"><div class="ss10 ws0 ps45"><div><table style="border-collapse:collapse;display:inline-table;font-size:initial;padding:0;table-layout:fixed;width:100%"><tbody><tr style="height:0"><td style="padding:0;width:108.75pt"></td><td style="padding:0;width:87.75pt"></td><td style="padding:0;width:50.25pt"></td><td style="padding:0;width:78pt"></td><td style="padding:0;width:52.5pt"></td><td style="padding:0;width:75.75pt"></td></tr><tr style="height:50.25pt"><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps1 ss335"><div><div class="ps566 ss334"><span class="f charStyle-9c0f18c6 ps3695">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3700 ss170"><div><div class="ps298 ss169"><span class="f charStyle-97e60454 ps3696">Fecha de <span class="f ps4"> </span></span></div><div class="ps329 ss169"><span class="f charStyle-97e60454 ps3697">inscripción en el </span></div><div class="ps571 ss169"><span class="f charStyle-97e60454 ps3698">Registro </span></div><div class="ps1636 ss169"><span class="f charStyle-97e60454 ps3699">Mercantil</span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3701 ss252"><div><div class="ps566 ss75"><span class="f charStyle-97e60454 ps2913">% Capital<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3704 ss337"><div><div class="ps329 ss336"><span class="f charStyle-97e60454 ps3702">Número de <span class="f ps4"> </span></span></div><div class="ps571 ss336"><span class="f charStyle-97e60454 ps3703">acciones</span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3706 ss339"><div><div class="ps566 ss338"><span class="f charStyle-97e60454 ps3705">Nominal<span class="f ps4"> </span></span></div></div></div></td><td style="background-color:#007f33;border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3708 ss341"><div><div class="ps566 ss340"><span class="f charStyle-97e60454 ps3707">Euros<span class="f ps4"> </span></span></div></div></div></td></tr><tr style="height:14.25pt"><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps2320 ss342"><div><div class="ps298 ss334"><span class="f charStyle-791788a1 ps51">Saldo a 01.01.2024<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3710 ss173"><div><div class="ps298 ss169"><span class="f charStyle-97e60454 ps3709">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3711 ss89"><div><div class="ps298 ss75"><span class="f charStyle-97e60454 ps3378">sin dato<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3713 ss343"><div><div class="ps298 ss336"><span class="f charStyle-791788a1 ps3712">6.350.278.000<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3715 ss344"><div><div class="ps298 ss338"><span class="f charStyle-791788a1 ps3714">0,75<span class="f ps4"> </span></span></div></div></div></td><td style="border-bottom:0.5pt solid #000;border-left:0.5pt solid #000;border-right:0.5pt solid #000;border-top:0.5pt solid #000;padding:0"><div class="ps3717 ss345"><div><div class="ps298 ss340"><span class="f charStyle-791788a1 ps3716">4.762.