<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<html xmlns="http://www.w3.org/1999/xhtml"><head><title>Bank Annual Report BBVA,S.A. 2024</title><style type="text/css">


body {
  background-color: #E4E4E4;
  font-family: ArialMT, Sans Serif;
  word-wrap: break-word;
}

p {
  line-height: 1.2;
  margin: 0;
  padding: 0;
}

table {
  border-collapse: collapse;
  display: block;
  padding: 0 0 0.6em 0;
  table-layout: fixed;
  width: 100%;
}

td, th {
  font-size: 0;
  padding-bottom: 1.5pt;
  padding-left: 2.63pt;
  padding-right: 2.63pt;
  padding-top: 2.63pt;
  text-align: left;
  vertical-align: top;
}

img {
  border: none;
}

a {
  color: inherit;
  text-decoration: inherit;
}

div.fnSep {
  border-bottom: 1pt solid #000000;
  margin-bottom: 5pt;
  margin-top: 10pt;
  width: 200pt;
}

div.pageView {
  background-color: #FFFFFF;
  border: 1px solid #CCCC;
  content-visibility: auto;
  float: none;
  font-size: 0;
  margin: 10px auto 10px auto;
  overflow: hidden;
  padding: 0;
  position: relative;
}

div.cell {
  display: flex;
  flex-direction: column;
}

span.fidelity {
  white-space: pre;
}

span.Subscript {
  font-size: 0.65em;
  vertical-align: sub;
}

span.Superscript {
  font-size: 0.65em;
  vertical-align: super;
}

span.Bold {
  font-weight: bold;
}

span.BoldItalic {
  font-style: italic;
  font-weight: bold;
}

span.Hyperlink {
  color: #0000ff;
  text-decoration: underline;
}

span.Italic {
  font-style: italic;
}

span.Black {
  color: #000000;
}

span.Subscript {
  font-size: 0.65em;
  vertical-align: sub;
}

span.Superscript {
  font-size: 0.65em;
  vertical-align: super;
}

