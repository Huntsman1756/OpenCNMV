  vertical-align: super;
}

span.Bold {
  font-weight: bold;
}

span.BoldItalic {
  font-style: italic;
  font-weight: bold;
}

span.Hyperlink {
  color: #0000ff;
  text-decoration: underline;
}

span.Italic {
  font-style: italic;
}

span.Black {
  color: #000000;
}

